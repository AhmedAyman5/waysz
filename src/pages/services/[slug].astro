---
import { getCollection } from 'astro:content';
import ServiceDetailPage from '../../views/ServiceDetailPage.astro';
import LegalServicePage from '../../views/LegalServicePage.astro';
import TravelServicePage from '../../views/TravelServicePage.astro';
import EventsServicePage from '../../views/EventsServicePage.astro';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
---
{entry.data.area === 'legal'
  ? <LegalServicePage lang="ar" entry={entry} />
  : entry.data.area === 'travel'
    ? <TravelServicePage lang="ar" entry={entry} />
    : entry.data.area === 'events'
      ? <EventsServicePage lang="ar" entry={entry} />
      : <ServiceDetailPage lang="ar" entry={entry} />}
