---
/**
 * Software page — hero, "Code in flight". Scene: motion/scenes/code-hero.ts · WebGL act: stage/acts/glyphs.ts.
 * Dusk over a city (real footage); in front of it a short program assembles itself out of flying characters,
 * with the page title staged by words beside it. Scrolling lifts the code off again (fully reversible).
 *   WebGL tiers: every character is an instanced quad from a glyph atlas, plus a slow galaxy of glyphs in depth
 *                that the pointer pushes away like a field.
 *   css tier:    the same characters as DOM spans moved with GSAP.
 *   no JS / reduced motion: the finished code, static.
 * The code is decorative (aria-hidden) and LTR in both languages. The lead and the buttons are painted at once
 * (LCP); only the headline and the code are staged.
 */
import BgVideo from '../../components/BgVideo.astro';
import Code from './Code.astro';
import { localizePath, useTranslations, type Lang } from '../../i18n';

interface Props { lang: Lang; lead: string }
const { lang, lead } = Astro.props;
const t = useTranslations(lang);
const title = { ar: ['البرمجيات', 'والتقنية'], en: ['Software', '& Technology'] }[lang];

// our own tiny program: how a request becomes a launched product
const program = [
  '// waysz: software & technology',
  'const need = listen(client);',
  'const plan = design(need);',
  '',
  'build(plan)',
  '  .then(test)',
  '  .then(launch);',
];
---
<section class="chero theme-dark" data-scene="code-hero" data-waypoint aria-labelledby="chero-title">
  <div class="chero__sticky">
    <div class="chero__media" aria-hidden="true">
      <div class="chero__plate"><BgVideo name="code-dusk" mobile="code-dusk-m" eager /></div>
      <div class="chero__scrim"></div>
    </div>
    <div class="chero__codebox" aria-hidden="true"><Code lines={program} /></div>
    <div class="chero__stage stage-host" aria-hidden="true"></div>

    <div class="chero__content container">
      <nav class="chero__crumb" aria-label={t.nav.services}>
        <a href={localizePath('/services/', lang)}>{t.nav.services}</a>
        <svg class="icon-dir" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="m9 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span aria-current="page">{t.areas.software}</span>
      </nav>
      <h1 class="chero__title" id="chero-title" data-intro>
        {title.map((line) => <span class="chero__line">{line}{' '}</span>)}
      </h1>
      <p class="chero__lead">{lead}</p>
      <div class="chero__actions">
        <a class="btn btn--accent" href="#consult" data-magnetic>{t.cta.consult}</a>
        <a class="btn btn--ghost" href="#services">{t.cta.explore}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .chero { position: relative; }
  .chero__sticky {
    position: relative; overflow: hidden;
    height: 100vh; height: 100svh; min-height: 38rem;
    display: grid; align-items: end;
    /* where the footage sits behind the screen (the act reads the same two numbers): the horizon band stays
       above the code on wide screens, between the code and the text on small ones */
    --plate-top: -0.04; --plate-h: 1.12;
  }
  @media (min-width: 1024px) { .chero__sticky { --plate-top: -0.3; --plate-h: 1.3; } }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .chero { height: 180vh; height: 180lvh; }
    :global(.js) .chero__sticky { position: sticky; top: 0; height: 100vh; height: 100lvh; }
    :global(.js) .chero__content { padding-block-end: calc(100lvh - 100svh + var(--space-8)); }
    /* the code waits (hidden) for the scene to stage it; the boot failsafe removes .js if motion never starts */
    :global(.js) .chero__codebox { visibility: hidden; }
  }
  .chero__media, .chero__scrim { position: absolute; inset: 0; }
  .chero__media { overflow: hidden; }
  .chero__plate { position: absolute; inset-inline: 0; top: calc(var(--plate-top) * 100%); height: calc(var(--plate-h) * 100%); }
  /* the same three layers are computed in the act's backdrop shader (shaders/glyphs.glsl.ts): keep them in sync */
  .chero__scrim {
    background:
      linear-gradient(to top, color-mix(in srgb, var(--color-bg) 96%, transparent) 0%, color-mix(in srgb, var(--color-bg) 62%, transparent) 40%, transparent 80%),
      linear-gradient(to bottom, color-mix(in srgb, var(--color-bg) 62%, transparent) 0%, transparent 24%),
      linear-gradient(color-mix(in srgb, var(--color-bg) 26%, transparent), color-mix(in srgb, var(--color-bg) 26%, transparent));
  }
  .chero__stage { z-index: 1; }

  /* the code: top of the screen on phones, the free side of the screen on wide ones */
  .chero__codebox {
    position: absolute; top: calc(76px + var(--space-5)); inset-inline: 0;
    display: flex; justify-content: center;
    perspective: 900px;
    --code-size: clamp(0.72rem, 3.2vw, 0.95rem);
  }
  .chero__codebox :global(.code) { position: relative; }
  @media (min-width: 1024px) {
    .chero__codebox {
      top: 0; bottom: 14%; inset-inline: auto max(calc((100vw - 1240px) / 2), clamp(1rem, 4vw, 2.5rem));
      align-items: center;
      --code-size: clamp(1.05rem, 0.5rem + 0.95vw, 1.5rem);
    }
  }

  .chero__content { position: relative; z-index: 2; padding-block: calc(76px + var(--space-6)) var(--space-8); }
  .chero__crumb { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); color: color-mix(in srgb, var(--color-ink) 80%, transparent); }
  .chero__crumb a { text-decoration: none; }
  .chero__crumb a:hover { color: var(--color-link); }
  .chero__title {
    margin-block-start: var(--space-4);
    font-size: clamp(2.7rem, 1rem + 7.4vw, 8.25rem); line-height: 1.1; letter-spacing: -0.015em;
  }
  :global([dir='rtl']) .chero__title { letter-spacing: 0; line-height: 1.28; }
  .chero__line { display: block; }
  .chero__lead {
    margin-block-start: var(--space-5); max-width: 46ch;
    font-size: var(--text-lg); line-height: 1.75; color: color-mix(in srgb, var(--color-ink) 90%, transparent);
  }
  .chero__actions { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-block-start: var(--space-6); }
  .chero__actions .btn { min-height: 54px; padding-inline: var(--space-7); font-size: var(--text-base); }
  @media (max-width: 639px) {
    .chero__lead { font-size: var(--text-base); }
    .chero__actions { gap: var(--space-3); }
    .chero__actions .btn { flex: 1 1 100%; min-height: 50px; }
  }
</style>
