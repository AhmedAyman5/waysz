---
/**
 * Events detail page — hero (theme-dark). A full-bleed photo of the service behind a velvet-dark gradient (AA), the
 * breadcrumb, the area label after a thin gold rule, the service name (words rise), the description and the
 * call buttons; a gold hairline closes the hero like the edge of a stage.
 * The photo fills the screen on phones too, so the description stays the largest paint (LCP). No WebGL, no pin.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Bidi from './Bidi.astro';
import { GROUP_PAGE } from '../../data/services';
import { site, waHref } from '../../lib/site';
import { localizePath, useTranslations, type Lang } from '../../i18n';

interface Props { lang: Lang; name: string; description: string; photo: ImageMetadata; alt: string; focus?: string }
const { lang, name, description, photo, alt, focus = '50% 50%' } = Astro.props;
const t = useTranslations(lang);
const chevron = '<path d="m9 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>';
---
<section class="esh" aria-labelledby="esh-title">
  <div class="esh__media">
    <Image src={photo} alt={alt} widths={[640, 960, 1440, 1920]} sizes="100vw" format="webp" quality={62}
           loading="eager" fetchpriority="high" decoding="async" style={`object-position: ${focus}`} />
  </div>
  <div class="esh__scrim" aria-hidden="true"></div>

  <div class="esh__content container">
    <nav class="esh__crumb" aria-label={t.nav.services}>
      <a href={localizePath('/services/', lang)}>{t.nav.services}</a>
      <svg class="icon-dir" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" set:html={chevron} />
      <a href={localizePath(GROUP_PAGE.events, lang)}>{t.areas.events}</a>
      <svg class="icon-dir" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" set:html={chevron} />
      <span aria-current="page">{name}</span>
    </nav>
    <p class="esh__area"><span class="esh__mark" aria-hidden="true"></span>{t.areas.events}</p>
    <h1 class="esh__title" id="esh-title" data-split="words">{name}</h1>
    <p class="esh__lead"><Bidi text={description} lang={lang} /></p>
    <div class="esh__actions">
      <a class="btn btn--accent" href={localizePath('/contact/', lang)}>{t.cta.consult}</a>
      {site.whatsapp && (
        <a class="btn btn--ghost" href={waHref(site.whatsapp, `${t.whatsapp.message}${name}`)} target="_blank" rel="noopener">{t.cta.whatsapp}</a>
      )}
    </div>
  </div>
</section>

<style is:inline>
  .esh {
    position: relative; overflow: clip; isolation: isolate;
    min-height: 100vh; min-height: 100svh;
    display: grid; align-items: end;
  }
  @media (min-width: 1024px) { .esh { min-height: 88vh; min-height: 88svh; } }
  .esh__media, .esh__scrim { position: absolute; inset: 0; z-index: -1; }
  .esh__media img { width: 100%; height: 100%; object-fit: cover; }
  /* the text always sits on this gradient: AA on the brightest part of every photo (screens, spotlights) */
  .esh__scrim {
    background:
      linear-gradient(to top, var(--esp-bg) 0%, color-mix(in srgb, var(--esp-bg) 90%, transparent) 32%, color-mix(in srgb, var(--esp-bg) 62%, transparent) 62%, color-mix(in srgb, var(--color-velvet-deep) 34%, transparent) 100%),
      linear-gradient(to bottom, color-mix(in srgb, var(--esp-bg) 70%, transparent), transparent 22%);
  }
  .esh::after { content: ''; position: absolute; inset-block-end: 0; inset-inline: 0; height: 1px; background: linear-gradient(to right, transparent, var(--color-accent), transparent); opacity: 0.8; }
  .esh__content { padding-block: calc(76px + var(--space-7)) var(--space-8); }
  .esh__crumb { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); font-size: var(--text-sm); color: color-mix(in srgb, var(--color-ink) 84%, transparent); }
  .esh__crumb a { text-decoration: none; }
  .esh__crumb a:hover { color: var(--color-link); text-decoration: underline; }
  .esh__area {
    display: flex; align-items: center; gap: var(--space-3); margin-block-start: var(--space-6);
    font-family: var(--font-display); font-weight: var(--weight-bold); font-size: var(--text-sm); color: var(--color-accent);
  }
  .esh__mark { width: 28px; height: 1.5px; background: currentColor; }
  .esh__title {
    margin-block-start: var(--space-3); max-width: 16ch;
    font-size: clamp(2.6rem, 1.2rem + 5.6vw, 6.4rem); line-height: 1.08; letter-spacing: -0.015em;
  }
  [dir='rtl'] .esh__title { line-height: 1.3; letter-spacing: 0; }
  .esh__lead { margin-block-start: var(--space-5); max-width: 62ch; font-size: var(--text-lg); line-height: 1.8; color: color-mix(in srgb, var(--color-ink) 92%, transparent); }
  .esh__actions { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-block-start: var(--space-7); }
  .esh__actions .btn { min-height: 54px; padding-inline: var(--space-7); font-size: var(--text-base); white-space: normal; text-align: center; }
  @media (max-width: 639px) {
    .esh__lead { font-size: var(--text-base); }
    .esh__actions .btn { flex: 1 1 100%; }
  }
</style>
