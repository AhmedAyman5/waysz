---
/**
 * Events detail page — what's not included: a calm box with × marks. Never animated (it is a limit of the
 * service: read it as it is).
 */
import Bidi from './Bidi.astro';
import { useTranslations, type Lang } from '../../i18n';

interface Props { lang: Lang; items: string[] }
const { lang, items } = Astro.props;
const t = useTranslations(lang);
---
{items.length > 0 && (
  <section class="esx esp-sec" aria-labelledby="esx-title">
    <div class="esx__box">
      <h2 class="esx__title" id="esx-title">{t.service.excludes}</h2>
      <ul class="esx__list" role="list">
        {items.map((x) => (
          <li><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M7 7l10 10M17 7 7 17" /></svg><span><Bidi text={x} lang={lang} /></span></li>
        ))}
      </ul>
    </div>
  </section>
)}

<style is:inline>
  .esx__box {
    padding: clamp(1.5rem, 1rem + 2.5vw, 2.75rem); border-radius: var(--radius-lg);
    background: var(--esp-surface); border: 1px solid var(--color-border);
  }
  .esx__title { font-size: var(--text-xl); line-height: 1.35; }
  .esx__list { display: grid; gap: var(--space-4); margin-block-start: var(--space-5); }
  .esx__list li { display: grid; grid-template-columns: 18px 1fr; gap: var(--space-4); align-items: start; line-height: 1.8; color: color-mix(in srgb, var(--color-ink) 82%, transparent); }
  .esx__list svg { margin-block-start: 0.35em; fill: none; stroke: var(--color-ink-muted); stroke-width: 1.8; stroke-linecap: round; }
</style>
