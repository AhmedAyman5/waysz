---
/**
 * Legal detail page — hero (theme-dark). A full-bleed photo of the department behind a dark gradient (AA), the
 * breadcrumb, the area label, the department name (words rise), the description and the call buttons.
 * The photo fills the screen on phones too, so the description stays the largest paint (LCP). No WebGL, no pin.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Bidi from './Bidi.astro';
import { site, waHref } from '../../lib/site';
import { localizePath, useTranslations, type Lang } from '../../i18n';

interface Props { lang: Lang; name: string; description: string; photo: ImageMetadata; alt: string; focus?: string }
const { lang, name, description, photo, alt, focus = '50% 50%' } = Astro.props;
const t = useTranslations(lang);
const chevron = '<path d="m9 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>';
---
<section class="lsh theme-dark" aria-labelledby="lsh-title">
  <div class="lsh__media">
    <Image src={photo} alt={alt} widths={[640, 960, 1440, 1920, 2400]} sizes="100vw" format="webp" quality={62}
           loading="eager" fetchpriority="high" decoding="async" style={`object-position: ${focus}`} />
  </div>
  <div class="lsh__scrim" aria-hidden="true"></div>

  <div class="lsh__content container">
    <nav class="lsh__crumb" aria-label={t.nav.services}>
      <a href={localizePath('/services/', lang)}>{t.nav.services}</a>
      <svg class="icon-dir" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" set:html={chevron} />
      <a href={localizePath('/services/legal-services/', lang)}>{t.areas.legal}</a>
      <svg class="icon-dir" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" set:html={chevron} />
      <span aria-current="page">{name}</span>
    </nav>
    <p class="lsh__area"><span class="lsh__mark" aria-hidden="true"></span>{t.areas.legal}</p>
    <h1 class="lsh__title" id="lsh-title" data-split="words">{name}</h1>
    <p class="lsh__lead"><Bidi text={description} lang={lang} /></p>
    <div class="lsh__actions">
      <a class="btn btn--accent" href={localizePath('/contact/', lang)}>{t.cta.consult}</a>
      {site.whatsapp && (
        <a class="btn btn--ghost" href={waHref(site.whatsapp, `${t.whatsapp.message}${name}`)} target="_blank" rel="noopener">{t.cta.whatsapp}</a>
      )}
    </div>
  </div>
</section>

<style is:inline>
  .lsh {
    position: relative; overflow: clip; isolation: isolate;
    min-height: 100vh; min-height: 100svh;
    display: grid; align-items: end;
  }
  @media (min-width: 1024px) { .lsh { min-height: 88vh; min-height: 88svh; } }
  .lsh__media, .lsh__scrim { position: absolute; inset: 0; z-index: -1; }
  .lsh__media img { width: 100%; height: 100%; object-fit: cover; }
  /* the text always sits on this gradient: AA on the brightest part of every photo */
  .lsh__scrim {
    background:
      linear-gradient(to top, var(--color-bg) 0%, color-mix(in srgb, var(--color-bg) 88%, transparent) 30%, color-mix(in srgb, var(--color-bg) 55%, transparent) 62%, color-mix(in srgb, var(--color-bg) 30%, transparent) 100%),
      linear-gradient(to bottom, color-mix(in srgb, var(--color-bg) 70%, transparent), transparent 22%);
  }
  .lsh__content { padding-block: calc(76px + var(--space-7)) var(--space-8); }
  .lsh__crumb { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); font-size: var(--text-sm); color: color-mix(in srgb, var(--color-ink) 84%, transparent); }
  .lsh__crumb a { text-decoration: none; }
  .lsh__crumb a:hover { color: var(--color-link); text-decoration: underline; }
  .lsh__area {
    display: flex; align-items: center; gap: var(--space-3); margin-block-start: var(--space-6);
    font-family: var(--font-display); font-weight: var(--weight-semibold); font-size: var(--text-sm); color: var(--color-area-legal);
  }
  .lsh__mark { width: 28px; height: 1.5px; background: currentColor; }
  .lsh__title {
    margin-block-start: var(--space-3); max-width: 18ch;
    font-size: clamp(2.3rem, 1.2rem + 4.6vw, 5.4rem); line-height: 1.12; letter-spacing: -0.01em;
  }
  [dir='rtl'] .lsh__title { line-height: 1.32; letter-spacing: 0; }
  .lsh__lead { margin-block-start: var(--space-5); max-width: 64ch; font-size: var(--text-lg); line-height: 1.8; color: color-mix(in srgb, var(--color-ink) 92%, transparent); }
  .lsh__actions { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-block-start: var(--space-7); }
  .lsh__actions .btn { min-height: 54px; padding-inline: var(--space-7); font-size: var(--text-base); white-space: normal; text-align: center; }
  @media (max-width: 639px) {
    .lsh__lead { font-size: var(--text-base); }
    .lsh__actions .btn { flex: 1 1 100%; }
  }
</style>
