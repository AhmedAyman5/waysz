---
/**
 * Events page — registration and attendance: "from registration to seat". Scene: motion/scenes/events-badge.ts.
 * A sticky screen (no pin). The camera of the stage act `gala` stands at the back of the hall, high over the seats.
 * A guest badge drops into view on its lanyard (3D, rope physics): grab it and swing it, it settles back. A line of
 * light scans its QR code, and the seats of the hall light up one by one as attendees "register" (the seat map).
 * The badge carries our logo, the word «ضيف» / "Guest" and a QR-like pattern — no personal name, nothing encoded.
 * `.greg__pad` is the only part that takes the pointer (touch-action: none on the badge only; the page scrolls
 * everywhere else). css tier (no WebGL) / no JS: the same badge in HTML, swinging with CSS / GSAP.
 */
import { localizePath, useTranslations, type Lang } from '../../i18n';
import type { ServiceItem } from './Services.astro';

interface Props { lang: Lang; item: ServiceItem }
const { lang, item } = Astro.props;
const t = useTranslations(lang);
const copy = {
  ar: { title: 'من التسجيل إلى المقعد', hint: 'اسحب البطاقة وحرّكها', guest: 'ضيف' },
  en: { title: 'From registration to seat', hint: 'Grab the badge and swing it', guest: 'Guest' },
}[lang];
---
<section class="greg" id="register" data-scene="events-badge" data-shot data-waypoint aria-labelledby="greg-title">
  <div class="greg__view">
    <div class="greg__scrim g-scrim" aria-hidden="true"></div>

    <!-- the badge in HTML: css tier / no JS only (the 3D one replaces it when the canvas draws) -->
    <div class="greg__dom" aria-hidden="true">
      <div class="greg__strap"></div>
      <div class="greg__card">
        <div class="greg__band"><span>WaysZ</span></div>
        <strong class="greg__word">{copy.guest}</strong>
        <i class="greg__rule"></i>
        <svg class="greg__qr" viewBox="0 0 25 25" shape-rendering="crispEdges">
          <path d="M0 0h7v7H0zM2 2v3h3V2zM18 0h7v7h-7zM20 2v3h3V2zM0 18h7v7H0zM2 20v3h3v-3zM9 1h2v2H9zM12 0h2v3h-2zM9 5h3v2H9zM14 4h2v2h-2zM8 9h3v2H8zM12 8h2v3h-2zM16 9h3v2h-3zM20 8h2v2h-2zM23 9h2v3h-2zM0 9h2v2H0zM3 10h3v2H3zM9 13h2v3H9zM13 12h3v2h-3zM18 13h2v2h-2zM21 13h3v3h-3zM1 14h3v2H1zM10 18h3v2h-3zM15 17h2v3h-2zM19 18h2v2h-2zM22 19h3v2h-3zM9 22h2v3H9zM12 21h3v2h-3zM17 22h3v3h-3zM22 23h2v2h-2z"/>
        </svg>
        <i class="greg__scan"></i>
      </div>
    </div>

    <div class="greg__pad" aria-hidden="true"></div>

    <div class="greg__content container">
      <h2 class="g-title greg__title" id="greg-title">{copy.title}</h2>
      <h3 class="greg__name">{item.name}</h3>
      <p class="g-lead greg__text">{item.text}</p>
      <a class="link-arrow g-link greg__link" href={localizePath(`/services/${item.slug}/`, lang)}>
        {t.cta.details}<span class="visually-hidden">: {item.name}</span>
        <svg class="icon-dir" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <p class="greg__hint" aria-hidden="true"><span class="greg__hand"></span>{copy.hint}</p>
    </div>
  </div>
</section>

<style>
  .greg { position: relative; }
  .greg__view { position: relative; overflow: clip; min-height: 100vh; min-height: 100svh; display: grid; align-items: end; }
  :global(.js) .greg { height: 260vh; height: 260lvh; }
  :global(.js) .greg__view { position: sticky; top: 0; height: 100vh; height: 100lvh; }
  @media (min-width: 1024px) { .greg__view { align-items: center; } }

  .greg__scrim { background: linear-gradient(to top, color-mix(in srgb, var(--color-bg) 94%, transparent) 0%, color-mix(in srgb, var(--color-bg) 70%, transparent) 36%, transparent 60%); }
  @media (min-width: 1024px) {
    .greg__scrim { background: linear-gradient(to right, color-mix(in srgb, var(--color-bg) 88%, transparent) 0%, color-mix(in srgb, var(--color-bg) 60%, transparent) 34%, transparent 55%); }
    :global([dir='rtl']) .greg__scrim { background: linear-gradient(to left, color-mix(in srgb, var(--color-bg) 88%, transparent) 0%, color-mix(in srgb, var(--color-bg) 60%, transparent) 34%, transparent 55%); }
  }

  .greg__content { position: relative; z-index: 2; padding-block: calc(76px + var(--space-6)) var(--space-8); pointer-events: none; }
  .greg__content a { pointer-events: auto; }
  @media (min-width: 1024px) { .greg__content > * { max-width: 32rem; } }
  .greg__name { margin-block-start: var(--space-5); font-size: var(--text-xl); }
  .greg__text { margin-block-start: var(--space-2); }
  .greg__link { margin-block-start: var(--space-4); }
  .greg__hint { display: flex; align-items: center; gap: var(--space-3); margin-block-start: var(--space-6); font-size: var(--text-sm); color: var(--color-ink-muted); }
  .greg__hand { width: 22px; height: 22px; border-radius: 50%; border: 1.5px solid var(--color-accent); position: relative; }
  .greg__hand::after { content: ''; position: absolute; inset: 5px; border-radius: 50%; background: var(--color-accent); animation: greg-tap 1.8s var(--ease-in-out) infinite; }
  @keyframes greg-tap { 50% { scale: 0.5; opacity: 0.5; } }
  :global(html:not([data-tier='full'])) .greg__hint { display: none; }

  /* the pad over the 3D badge: it takes the pointer only there */
  .greg__pad { position: absolute; z-index: 3; touch-action: none; cursor: grab; display: none; }
  .greg__pad:active { cursor: grabbing; }
  :global(html[data-tier='full'].js) .greg__pad { display: block; inset-block: 28% 38%; inset-inline: 34%; }
  @media (min-width: 1024px) {
    :global(html[data-tier='full'].js) .greg__pad { inset-block: 18% 24%; inset-inline: 60% 18%; }
  }

  /* the HTML badge (css tier / no JS) */
  .greg__dom { position: absolute; z-index: 1; inset-block-start: 0; inset-inline-start: 50%; translate: -50% 0; display: grid; justify-items: center; pointer-events: none; }
  @media (min-width: 1024px) { .greg__dom { inset-inline-start: 72%; } }
  :global([dir='rtl']) .greg__dom { translate: 50% 0; }
  :global(html[data-tier='full'].js) .greg__dom { display: none; }
  .greg__strap { width: 16px; height: 26vh; background: linear-gradient(90deg, var(--color-velvet) 0 44%, var(--color-accent) 44% 56%, var(--color-velvet) 56%); }
  .greg__card {
    position: relative; width: clamp(150px, 16vw, 220px); aspect-ratio: 0.68; border-radius: 14px; overflow: hidden; margin-block-start: -4px;
    background: var(--color-ink); color: var(--color-bg); display: grid; grid-template-rows: auto auto auto 1fr; justify-items: center;
    box-shadow: 0 40px 80px -24px black;
  }
  .greg__band { width: 100%; padding-block: 18% 8%; background: var(--color-bg); color: var(--color-ink); text-align: center; font-weight: var(--weight-bold); border-block-end: 4px solid var(--color-accent); }
  .greg__word { margin-block-start: 10%; font-family: var(--font-display); font-size: clamp(2rem, 1.2rem + 2vw, 2.8rem); line-height: 1.1; }
  .greg__rule { width: 22%; height: 3px; margin-block-start: 6%; background: var(--color-velvet); }
  .greg__qr { align-self: center; width: 46%; fill: var(--color-bg); }
  .greg__scan { position: absolute; inset-inline: 22%; height: 2px; top: 62%; background: var(--color-accent); box-shadow: 0 0 14px var(--color-accent); opacity: 0; }
  @media (max-width: 1023px) { .greg__strap { height: 14vh; } .greg__card { width: 140px; } }
</style>
