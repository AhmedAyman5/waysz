---
/**
 * Events page — "the expo builds itself". Scene: motion/scenes/events-expo.ts.
 * A sticky screen (no pin). The camera of the stage act `gala` cranes up over the foyer: first only floor-plan
 * lines are drawn on the floor (space planning), then the twenty stands rise one by one — frame, panels, header,
 * counter, then their lights switch on (stand design & build). Four of them stand for a service: hover / focus a
 * row of the legend (or the stand itself) and that stand lights up.
 * css tier (no WebGL) / no JS: the same moment as an SVG floor plan whose stands fill in with the scroll.
 */
import { localizePath, useTranslations, type Lang } from '../../i18n';
import type { ServiceItem } from './Services.astro';

interface Props { lang: Lang; items: ServiceItem[] }
const { lang, items } = Astro.props;
const t = useTranslations(lang);
const copy = {
  ar: { title: 'من المخطط إلى الجناح', lead: 'نخطط المساحات ونوزع الأجنحة ومسارات الزوار، ثم نصمم كل جناح وننفذه ونركبه في موقع المعرض.', hint: 'مرّر المؤشر على جناح لتعرف خدمته' },
  en: { title: 'From floor plan to stand', lead: 'We plan the space, lay out the stands and the visitor routes, then design, build and install every stand on the show floor.', hint: 'Point at a stand to see its service' },
}[lang];
// the SVG floor plan of the css tier: the same 4 × 5 grid of stands as the 3D floor, seen from above
const cols = [6, 26, 62, 82], rows = [8, 26, 44, 62, 80];
const legendAt = [[1, 2], [2, 2], [1, 3], [2, 3]];          // the four labelled stands (col, row), legend order
---
<section class="gexpo" id="expo" data-scene="events-expo" data-shot data-waypoint aria-labelledby="gexpo-title">
  <div class="gexpo__view">
    <div class="gexpo__scrim g-scrim" aria-hidden="true"></div>
    <svg class="gexpo__plan" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      <path class="gexpo__aisle" d="M47 0V100M53 0V100" />
      {rows.map((y) => cols.map((x) => {
        const hot = legendAt.findIndex(([c, r]) => cols[c] === x && rows[r] === y);
        return <rect class="gexpo__booth" data-hot={hot >= 0 ? hot : undefined} x={x} y={y} width="13" height="13" rx="0.6" />;
      }))}
    </svg>
  </div>
  <div class="gexpo__over">
    <div class="gexpo__content container">
      <header>
        <h2 class="g-title gexpo__title" id="gexpo-title">{copy.title}</h2>
        <p class="g-lead">{copy.lead}</p>
      </header>
      <ul class="gexpo__legend" role="list">
        {items.map((s, i) => (
          <li class="gexpo__item" data-i={i}>
            <a class="gexpo__pick" href={localizePath(`/services/${s.slug}/`, lang)} aria-describedby={`gexpo-d${i}`} data-cursor={t.cursor.explore}>
              <span class="gexpo__dot" aria-hidden="true"></span>
              <span class="gexpo__name">{s.name}</span>
              <svg class="gexpo__arrow icon-dir" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <p class="gexpo__text" id={`gexpo-d${i}`}>{s.text}</p>
          </li>
        ))}
      </ul>
      <p class="gexpo__hint" aria-hidden="true">{copy.hint}</p>
    </div>
  </div>
</section>

<style>
  /* the view (3D floor, or the SVG plan) sticks; the text rides over it: held beside it on wide screens,
     scrolling over the lower part of the screen on small ones */
  .gexpo { position: relative; }
  .gexpo__view { position: relative; overflow: clip; height: 70vh; height: 70svh; }
  :global(.js) .gexpo { height: 300vh; height: 300lvh; }
  :global(.js) .gexpo__view { position: sticky; top: 0; height: 100vh; height: 100lvh; }
  .gexpo__over { position: relative; z-index: 1; }
  :global(.js) .gexpo__over { margin-block-start: -38vh; margin-block-start: -38lvh; }
  @media (min-width: 1024px) {
    :global(.js) .gexpo__over { position: sticky; top: 0; height: 100vh; height: 100lvh; margin-block-start: -100vh; margin-block-start: -100lvh; }
  }

  .gexpo__scrim { background: linear-gradient(to top, color-mix(in srgb, var(--color-bg) 80%, transparent) 0%, transparent 46%); }
  @media (min-width: 1024px) {
    .gexpo__scrim { background: linear-gradient(to right, color-mix(in srgb, var(--color-bg) 90%, transparent) 0%, color-mix(in srgb, var(--color-bg) 66%, transparent) 36%, transparent 58%); }
    :global([dir='rtl']) .gexpo__scrim { background: linear-gradient(to left, color-mix(in srgb, var(--color-bg) 90%, transparent) 0%, color-mix(in srgb, var(--color-bg) 66%, transparent) 36%, transparent 58%); }
  }

  /* the 2D plan: only where the canvas does not draw (css tier, no JS) */
  .gexpo__plan {
    position: absolute; inset-block: 14% 34%; inset-inline: 6%; width: 88%; height: 52%;
    fill: none; stroke: color-mix(in srgb, var(--color-focus) 60%, var(--color-ink)); stroke-width: 0.25; opacity: 0.85;
  }
  @media (min-width: 1024px) { .gexpo__plan { inset-block: 12%; inset-inline: 50% 4%; width: 46%; height: 76%; } }
  .gexpo__booth { fill: color-mix(in srgb, var(--color-ink) 6%, transparent); }
  .gexpo__booth[data-hot] { stroke: var(--color-accent); }
  .gexpo__booth.is-hot { fill: color-mix(in srgb, var(--color-accent) 40%, transparent); }
  .gexpo__aisle { stroke: var(--color-velvet); stroke-width: 0.6; }
  :global(html[data-tier='full']) .gexpo__plan { display: none; }

  .gexpo__content {
    display: grid; gap: var(--space-6); align-content: start;
    padding-block: var(--space-7) var(--space-9);
    background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--color-bg) 88%, transparent) var(--space-9));
  }
  @media (min-width: 1024px) {
    .gexpo__content { height: 100%; align-content: center; gap: var(--space-5); padding-block: calc(76px + var(--space-4)) var(--space-5); background: none; }
    .gexpo__content > * { max-width: 34rem; }
  }

  .gexpo__legend { display: grid; gap: var(--space-1); }
  .gexpo__item { border-block-start: 1px solid var(--color-border); padding-block: var(--space-2); }
  .gexpo__title { font-size: clamp(2.2rem, 1.4rem + 2.6vw, 3.9rem); }
  .gexpo__pick { display: flex; align-items: center; gap: var(--space-3); padding-block: var(--space-1); text-decoration: none; font-family: var(--font-display); font-weight: var(--weight-bold); font-size: var(--text-lg); line-height: 1.4; }
  .gexpo__arrow { flex: none; opacity: 0.5; transition: opacity var(--dur-fast) var(--ease-out), translate var(--dur-base) var(--ease-out); }
  .gexpo__item.is-hot .gexpo__arrow { opacity: 1; translate: 4px 0; }
  :global([dir='rtl']) .gexpo__item.is-hot .gexpo__arrow { translate: -4px 0; }
  .gexpo__dot { flex: none; width: 12px; height: 12px; border-radius: 3px; border: 1.5px solid var(--color-accent); transition: background-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-base) var(--ease-out); }
  .gexpo__text { padding-inline-start: calc(12px + var(--space-3)); color: color-mix(in srgb, var(--color-ink) 84%, transparent); font-size: var(--text-sm); line-height: 1.7; }
  .gexpo__item.is-hot .gexpo__dot { background: var(--color-accent); box-shadow: 0 0 18px var(--color-accent); }
  .gexpo__item.is-hot .gexpo__name { color: var(--color-link); }
  .gexpo__hint { font-size: var(--text-xs); color: var(--color-ink-muted); }
  :global(html:not([data-tier='full'])) .gexpo__hint { display: none; }
  @media (max-width: 1023px) { .gexpo__pick { font-size: var(--text-base); } .gexpo__hint { display: none; } }
</style>
