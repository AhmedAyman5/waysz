---
/**
 * Home §1.3 «مجالات خدماتنا» — "Four destinations". Scene: motion/scenes/areas.ts.
 * One sticky screen (CSS sticky, not a pin): we come out of the cloud of §1.2b onto the section title, then
 * each area arrives through a different transition. WebGL tiers draw the photos in the shared stage
 * (acts/wipe.ts); the css tier wipes the same <img>s with clip-path.
 * Without JS / reduced motion: the title, then four full-screen cards.
 * Photos never mirror: the text sits on the side that is free in each photo (`side`).
 */
import { Image } from 'astro:assets';
import { localizePath, useTranslations, type Lang } from '../../i18n';
import legal from '../../assets/media/legal-justice.jpg';
import travel from '../../assets/media/travel-terminal.jpg';
import events from '../../assets/media/events-hall.jpg';
import software from '../../assets/media/software-code.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

// Copy: brief §1.3 (Arabic is the source; English is a faithful translation).
const copy = {
  ar: {
    title: 'مجالات خدماتنا',
    legal: ['استشارات قانونية ومتابعة القضايا في القانون الجنائي والمدني وقضايا الأسرة وقوانين الشركات، إلى جانب الاستشارات القانونية في الهجرة والجنسية.', 'استكشف الخدمات القانونية'],
    travel: ['كل ما تحتاجه للسفر بثقة: استشارات الهجرة والإقامة، والدراسة بالخارج، والتأشيرات، والترجمة المعتمدة، واستشارات السفارات.', 'استكشف خدمات الهجرة والدراسة'],
    events: ['تنظيم مؤتمرات ومعارض دولية متكاملة، من التخطيط وتجهيز الأجنحة واستقبال الوفود، حتى الترجمة الفورية وإدارة يوم الحدث.', 'استكشف خدمات الفعاليات'],
    software: ['تصميم وتطوير المواقع، وبناء أنظمة مخصصة تساعد مؤسستك على تنظيم أعمالها والتحول الرقمي بثقة.', 'استكشف الحلول التقنية'],
  },
  en: {
    title: 'Our service areas',
    legal: ['Legal consultations and case follow-up in criminal law, civil law, family matters and corporate law, alongside legal consultations on immigration and citizenship.', 'Explore legal services'],
    travel: ['Everything you need to travel with confidence: immigration and residency consultations, study abroad, visas, certified translation and embassy consultations.', 'Explore immigration and study services'],
    events: ['Organizing complete international conferences and exhibitions — from planning, stand design and build and receiving delegations to simultaneous interpretation and event-day management.', 'Explore event services'],
    software: ['Website design and development, and custom systems that help your organization run its work and go digital with confidence.', 'Explore technology solutions'],
  },
}[lang];

const rtl = lang === 'ar';
// `side`: the physical side of the photo that is free for text · `focus`: horizontal focal point when cropped
const areas = [
  { key: 'legal', img: legal, hue: '--hue-legal', side: 'left', focus: 74 },
  { key: 'travel', img: travel, hue: '--hue-travel', side: rtl ? 'right' : 'left', focus: 46 },
  { key: 'events', img: events, hue: '--hue-events', side: 'right', focus: 34 },
  { key: 'software', img: software, hue: '--hue-software', side: 'left', focus: 72 },
] as const;
// areas that already have their own page (brief §2.2); the others open their tab on the Services page
const groupPage: Partial<Record<string, string>> = { travel: '/services/immigration-study-visa/' };
const hrefOf = (key: string) => (groupPage[key] ? localizePath(groupPage[key]!, lang) : `${localizePath('/services/', lang)}#${key}`);
const justify = (side: 'left' | 'right') => ((side === 'left') === !rtl ? 'start' : 'end');

// line icons, drawn by the scene (stroke only); [data-tilt] parts settle into place
const icons: Record<string, string> = {
  legal: '<path d="M24 9v30M16 40h16"/><g data-tilt><path d="M9 15h30"/><path d="M9 15 4.5 27h9L9 15ZM39 15l-4.5 12h9L39 15Z"/><path d="M4.5 27a4.5 3.4 0 0 0 9 0M34.5 27a4.5 3.4 0 0 0 9 0"/></g><circle cx="24" cy="8" r="2"/>',
  travel: '<circle cx="22" cy="26" r="14"/><path d="M8 26h28M22 12c-5 4-5 24 0 28M22 12c5 4 5 24 0 28"/><g data-tilt><path d="M30 14c4-6 9-8 13-8-1 4-3 9-9 13"/><path d="m33 11-6-1M38 16l1 6"/></g>',
  events: '<path d="M6 40h36M12 40V30h24v10"/><path d="M19 30v-5h10v5"/><g data-tilt><path d="M10 6l7 13M38 6l-7 13"/><path d="M8 6h6M34 6h6"/></g>',
  software: '<path d="M17 14 7 24l10 10M31 14l10 10-10 10"/><g data-tilt><path d="M27 9 21 39"/></g>',
};
---
<section class="areas" data-scene="areas" data-waypoint aria-labelledby="areas-title">
  <div class="areas__view" data-depth-scene>
    <div class="areas__stage stage-host" aria-hidden="true"></div>

    <header class="areas__intro">
      <h2 class="areas__title container" id="areas-title">{copy.title}</h2>
    </header>

    {areas.map((a) => (
      <article class="area theme-dark" id={`area-${a.key}`} data-side={a.side} style={`--hue: var(${a.hue}); --justify: ${justify(a.side)}; --focus: ${a.focus}%`}>
        <div class="area__media" aria-hidden="true">
          <div class="area__photo" data-depth="0.35">
            <Image src={a.img} alt="" widths={[640, 960, 1440, 1920, 2400]} sizes="100vw" format="webp" quality={68}
                   loading="lazy" decoding="async" data-focus={a.focus} />
          </div>
        </div>
        <div class="area__scrim" aria-hidden="true"></div>
        <div class="area__body container">
          <div class="area__text">
            <svg class="area__icon" viewBox="0 0 48 48" width="64" height="64" aria-hidden="true" set:html={icons[a.key]} />
            <h3 class="area__name">{t.areas[a.key]}</h3>
            <p class="area__copy">{copy[a.key][0]}</p>
            <a class="area__link link-arrow" href={hrefOf(a.key)} data-cursor={t.cursor.explore}>
              {copy[a.key][1]}
              <svg class="icon-dir" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>
      </article>
    ))}

    <div class="areas__ticks container" aria-hidden="true">{areas.map(() => <span></span>)}</div>
  </div>
</section>

<style>
  /* ---------- base: no JS / reduced motion — a title, then four full-screen cards ---------- */
  .areas { position: relative; background: var(--color-bg); }
  .areas__view { position: relative; }
  .areas__stage { z-index: 1; display: none; }
  .areas__intro { padding-block: var(--section-y) var(--space-8); background: var(--color-bg); }
  .areas__title { font-size: clamp(2.6rem, 1.4rem + 6vw, 7rem); line-height: 1.2; }

  .area { position: relative; min-height: 100vh; min-height: 100svh; display: grid; background: none; }
  .area__media { position: absolute; inset: 0; z-index: 0; overflow: hidden; background: var(--color-bg); }
  .area__photo { position: absolute; inset: -4%; }
  .area__photo :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: var(--focus) 50%; }
  .area__scrim {
    position: absolute; inset: 0; z-index: 2; pointer-events: none;
    background:
      linear-gradient(to top, color-mix(in srgb, var(--color-bg) 94%, transparent) 0%, color-mix(in srgb, var(--color-bg) 55%, transparent) 42%, transparent 78%),
      linear-gradient(to right, color-mix(in srgb, var(--color-bg) 78%, transparent), transparent 62%);
  }
  .area[data-side='right'] .area__scrim {
    background:
      linear-gradient(to top, color-mix(in srgb, var(--color-bg) 94%, transparent) 0%, color-mix(in srgb, var(--color-bg) 55%, transparent) 42%, transparent 78%),
      linear-gradient(to left, color-mix(in srgb, var(--color-bg) 78%, transparent), transparent 62%);
  }
  .area__body {
    position: relative; z-index: 4;
    display: grid; align-items: end; justify-items: var(--justify);
    padding-block: calc(76px + var(--space-6)) var(--space-9);
  }
  .area__text { max-width: 36rem; }
  .area__icon {
    width: clamp(48px, 5vw, 72px); height: auto; overflow: visible;
    fill: none; stroke: var(--hue); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round;
  }
  .area__name {
    margin-block: var(--space-5) var(--space-4);
    font-size: clamp(2.2rem, 1.3rem + 4.2vw, 5.25rem); font-weight: var(--weight-bold); line-height: 1.18;
    text-wrap: balance;
  }
  :global([dir='rtl']) .area__name { line-height: 1.34; }
  .area__copy { max-width: 46ch; font-size: var(--text-lg); line-height: 1.75; color: color-mix(in srgb, var(--color-ink) 86%, transparent); }
  .area__link {
    margin-block-start: var(--space-6); padding-block: var(--space-2);
    font-size: var(--text-base); color: var(--color-ink);
    border-block-end: 1.5px solid var(--hue);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .area__link:hover { color: var(--color-link); }
  .areas__ticks { display: none; }

  @media (prefers-reduced-motion: no-preference) {
    .area { position: sticky; top: 0; }          /* CSS-only stacking when the scene is not running */
  }
  @media (max-width: 639px) {
    .area__copy { font-size: var(--text-base); }
    .area__body { padding-block-end: var(--space-8); }
  }

  /* ---------- scrubbed: one sticky screen, everything layered ---------- */
  .areas:global(.is-scrub) {
    --unit: 90vh; height: calc(100vh + 4.4 * var(--unit)); height: calc(100lvh + 4.4 * var(--unit));
    /* slides in over the last moment of the journey (both are the page colour there): no empty screen between */
    z-index: 3; margin-block-start: -20vh; margin-block-start: -20lvh;
  }
  @media (max-width: 1023px) { .areas:global(.is-scrub) { --unit: 72vh; } }
  .areas:global(.is-scrub) .areas__view { position: sticky; top: 0; height: 100vh; height: 100lvh; overflow: hidden; }
  .areas:global(.is-scrub) .areas__stage { display: block; }
  .areas:global(.is-scrub) .areas__intro {
    position: absolute; inset: 0; z-index: 3;
    display: grid; align-items: start; padding-block: 30vh 0;
  }
  .areas:global(.is-scrub) .area { position: absolute; inset: 0; min-height: 0; }
  .areas:global(.is-scrub) .area__body {
    opacity: 0; pointer-events: none;
    padding-block-end: calc(100lvh - 100svh + var(--space-9));
  }
  .areas:global(.is-scrub) .area:global(.is-active) .area__body { pointer-events: auto; }
  .areas:global(.is-scrub) .area__scrim { opacity: 0; }
  .areas:global(.is-scrub) .areas__ticks {
    position: absolute; inset-inline: 0; inset-block-end: calc(100lvh - 100svh + var(--space-6)); z-index: 5;
    display: flex; gap: var(--space-2); opacity: 0; transition: opacity var(--dur-base) var(--ease-out);
  }
  .areas:global(.is-scrub.is-in) .areas__ticks { opacity: 1; }
  .areas__ticks span {
    width: 28px; height: 2px; border-radius: 2px;
    background: color-mix(in srgb, var(--color-on-brand) 30%, transparent);
    transition: background-color var(--dur-base) var(--ease-out);
  }
  .areas__ticks :global(span.is-on) { background: var(--color-accent); }

  /* the WebGL stage is painting: hide our own photos and the intro's flat background */
  .areas__stage:global(.is-drawing) ~ .area .area__media { visibility: hidden; }
  .areas__stage:global(.is-drawing) ~ .areas__intro { background: none; }
</style>
