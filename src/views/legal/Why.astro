---
/**
 * Legal page — «لماذا WaysZ؟», the four points of brief §1.4 that matter for legal work (clarity, a specialist
 * team, confidentiality, partnership), word for word. Scene: motion/scenes/legal-why.ts.
 * Beside them a sealed file: its lines are covered, and only the pointer's light shows the writing under them
 * (data-spotlight sets --mx / --my). It is decorative (aria-hidden, drawn strokes, nothing to read): the real
 * sentence about confidentiality is always readable in the list. Touch / no pointer: a slow light crosses it.
 * No JS / reduced motion: the list and the file, still.
 */
import type { Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const copy = {
  ar: {
    title: 'لماذا WaysZ؟',
    reasons: [
      ['clarity', 'وضوح من البداية', 'نشرح لك الخطوات والمتطلبات والمدة المتوقعة قبل البدء، دون مفاجآت.'],
      ['team', 'فريق متخصص لكل مجال', 'يتولى كل طلب فريق لديه الخبرة في مجاله، لتحصل على رأي دقيق وتنفيذ سليم.'],
      ['lock', 'سرية وخصوصية', 'نتعامل مع بياناتك وتفاصيل طلبك بأعلى درجات السرية والمسؤولية.'],
      ['rings', 'شراكة لا معاملة', 'نبني توصياتنا على تفاصيل حالتك، ونسعى لعلاقة طويلة قائمة على الثقة.'],
    ],
  },
  en: {
    title: 'Why WaysZ?',
    reasons: [
      ['clarity', 'Clarity from the start', 'We explain the steps, the requirements and the expected timeline before we begin — no surprises.'],
      ['team', 'A specialized team for every field', 'Each request is handled by a team experienced in its field, so you get an accurate opinion and sound execution.'],
      ['lock', 'Confidentiality and privacy', 'We treat your data and the details of your request with the highest levels of confidentiality and responsibility.'],
      ['rings', 'A partnership, not a transaction', 'We build our recommendations on the details of your case and aim for a long relationship built on trust.'],
    ],
  },
}[lang];
// the same line icons as Home §1.4 (views/home/Why.astro)
const icons: Record<string, string> = {
  clarity: '<path d="M8 13h22"/><path d="M8 24h22"/><path d="M8 35h13"/><path d="m28 34 4.500 4.500L42 28"/>',
  team: '<circle cx="24" cy="17" r="6"/><path d="M11 40c0-8 6-12 13-12s13 4 13 12"/><path d="M39 6v8M35 10h8"/>',
  lock: '<rect x="11" y="22" width="26" height="19" rx="3.500"/><path d="M16 22v-6a8 8 0 0 1 16 0v6"/><path d="M24 30v4"/>',
  rings: '<circle cx="18" cy="24" r="10.500"/><circle cx="30" cy="24" r="10.500"/>',
};
// handwriting without letters: the "text" of the sealed file
const scrawl = (y: number, w: number, k: number) => {
  let d = `M24 ${y}`;
  for (let x = 24; x < 24 + w; x += 9) d += `q${2 + ((x * k) % 3)} ${-5 - ((x + k) % 4)} 4.500 0t4.500 0`;
  return d;
};
const rows = [[40, 150, 3], [58, 196, 5], [76, 176, 7], [94, 196, 2], [112, 120, 9], [142, 196, 4], [160, 164, 6], [178, 190, 8], [196, 96, 1]];
---
<section class="lwhy" data-scene="legal-why" data-shot data-waypoint aria-labelledby="lwhy-title">
  <div class="lwhy__scrim" aria-hidden="true"></div>
  <div class="lwhy__in container">
    <div class="lwhy__main">
      <h2 class="lwhy__title" id="lwhy-title">{copy.title}</h2>
      <ul class="lwhy__list" role="list">
        {copy.reasons.map(([icon, title, text]) => (
          <li class="lreason" data-icon={icon}>
            <svg class="lreason__icon" viewBox="0 0 48 48" width="44" height="44" aria-hidden="true" set:html={icons[icon]} />
            <h3>{title}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ul>
    </div>

    <div class="lwhy__file" aria-hidden="true">
      <div class="file" data-spotlight>
        <svg class="file__ink" viewBox="0 0 244 300" preserveAspectRatio="none">
          {rows.map(([y, w, k]) => <path d={scrawl(y, w, k)} />)}
          <path class="file__sign" d="M30 252c10-22 18-26 20-12s-10 22-5 8 20-32 28-18-3 20 5 12 12-17 20-10 3 12 12 8" />
        </svg>
        <div class="file__bars">{rows.map(([y, w]) => <i style={`--y: ${y}; --w: ${w}`}></i>)}</div>
        <svg class="file__seal" viewBox="0 0 64 64" width="64" height="64"><circle cx="32" cy="32" r="26"/><circle cx="32" cy="32" r="19"/><rect x="23" y="30" width="18" height="13" rx="2.500"/><path d="M26.500 30v-4a5.500 5.500 0 0 1 11 0v4"/></svg>
      </div>
    </div>
  </div>
</section>

<style>
  .lwhy { position: relative; overflow-x: clip; padding-block: calc(var(--section-y) * 1.2); }
  .lwhy__scrim {
    position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--color-bg) 64%, transparent) 16%, color-mix(in srgb, var(--color-bg) 64%, transparent) 84%, transparent);
  }
  .lwhy__in { position: relative; display: grid; gap: var(--space-8); }
  .lwhy__title { font-size: clamp(2.6rem, 1.5rem + 5.4vw, 6.5rem); line-height: 1.16; }
  :global([dir='rtl']) .lwhy__title { line-height: 1.34; }
  .lwhy__list { display: grid; gap: var(--space-6) var(--space-7); grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); margin-block-start: var(--space-7); }
  .lreason { padding-block-start: var(--space-5); border-block-start: 1px solid var(--color-border); }
  .lreason__icon { overflow: visible; fill: none; stroke: var(--color-accent); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .lreason h3 { margin-block: var(--space-4) var(--space-2); font-size: var(--text-xl); line-height: 1.4; }
  .lreason p { max-width: 40ch; line-height: 1.8; color: color-mix(in srgb, var(--color-ink) 88%, transparent); }

  /* ---------- the sealed file ---------- */
  .lwhy__file { display: grid; place-items: center; }
  .file {
    --mx: 30%; --my: 24%;
    position: relative; width: min(100%, 19rem); aspect-ratio: 244 / 300; rotate: -3deg;
    border-radius: var(--radius-md); border: 1px solid color-mix(in srgb, var(--color-ink) 22%, transparent);
    background: color-mix(in srgb, var(--color-bg-alt) 86%, transparent);
    box-shadow: var(--shadow-lg);
  }
  .file__ink, .file__bars { position: absolute; inset: 0; width: 100%; height: 100%; }
  .file__ink { fill: none; stroke: var(--color-link); stroke-width: 1.4; stroke-linecap: round; }
  .file__ink .file__sign { stroke: var(--color-ink); stroke-width: 1.8; }
  /* the covers: solid everywhere, open only inside the light */
  .file__bars {
    -webkit-mask: radial-gradient(circle 5.5rem at var(--mx) var(--my), transparent 30%, black 100%);
    mask: radial-gradient(circle 5.5rem at var(--mx) var(--my), transparent 30%, black 100%);
  }
  .file__bars i {
    position: absolute; inset-inline-start: 8%; top: calc(var(--y) / 300 * 100% - 2.6%);
    width: calc(var(--w) / 244 * 100%); height: 4.4%; border-radius: 3px;
    background: color-mix(in srgb, var(--color-ink) 34%, var(--color-bg));
  }
  .file__bars::after {   /* the cover over the signature */
    content: ''; position: absolute; inset-inline-start: 8%; top: 76%; width: 46%; height: 13%; border-radius: 3px;
    background: color-mix(in srgb, var(--color-ink) 34%, var(--color-bg));
  }
  .file__seal { position: absolute; inset-inline-end: 9%; bottom: 8%; fill: none; stroke: var(--color-accent); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  @media (hover: none), (max-width: 1023px) {
    @media (prefers-reduced-motion: no-preference) { .file { animation: file-sweep 7s var(--ease-in-out) infinite alternate; } }
  }
  @property --mx { syntax: '<length-percentage>'; inherits: true; initial-value: 30%; }
  @property --my { syntax: '<length-percentage>'; inherits: true; initial-value: 24%; }
  @keyframes file-sweep { from { --mx: 18%; --my: 16%; } to { --mx: 78%; --my: 82%; } }

  @media (min-width: 1024px) {
    .lwhy { min-height: 100vh; min-height: 100svh; display: grid; align-items: center; }
    .lwhy__scrim { background: linear-gradient(to right, color-mix(in srgb, var(--color-bg) 84%, transparent) 0%, color-mix(in srgb, var(--color-bg) 62%, transparent) 46%, transparent 74%); }
    :global([dir='rtl']) .lwhy__scrim { background: linear-gradient(to left, color-mix(in srgb, var(--color-bg) 84%, transparent) 0%, color-mix(in srgb, var(--color-bg) 62%, transparent) 46%, transparent 74%); }
    .lwhy__in { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); align-items: center; gap: var(--space-9); }
    .lwhy__list { grid-template-columns: repeat(2, 1fr); }
    .file { width: min(100%, 21rem); }
  }
</style>
