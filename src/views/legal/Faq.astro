---
/**
 * Legal page — a short FAQ built from the detail pages (the questions and answers are read from the service
 * files, so they can never differ). Scenes: accordion (open / close) + legal-faq (heading, rows, `inert`).
 * Each answer links to the service it comes from. Without JS every answer is open.
 */
import { localizePath, useTranslations, type Lang } from '../../i18n';

interface Props { lang: Lang; items: { q: string; a: string; service: string; slug: string }[] }
const { lang, items } = Astro.props;
const t = useTranslations(lang);
---
<section class="lfaq" data-scene="accordion legal-faq" data-shot data-waypoint aria-labelledby="lfaq-title">
  <div class="lfaq__scrim" aria-hidden="true"></div>
  <div class="lfaq__in container">
    <h2 class="lfaq__title" id="lfaq-title">{t.service.faq}</h2>
    <div class="lfaq__list">
      {items.map((x, i) => (
        <div class="faq__item">
          <h3 class="lfaq__q">
            <button type="button" aria-expanded="false" aria-controls={`lfaq-${i}`}>
              <span>{x.q}</span>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
            </button>
          </h3>
          <div class="faq__panel" id={`lfaq-${i}`}>
            <div class="lfaq__a">
              <p>{x.a}</p>
              <a class="link-arrow" href={localizePath(`/services/${x.slug}/`, lang)}>
                {x.service}
                <svg class="icon-dir" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .lfaq { position: relative; padding-block: calc(var(--section-y) * 1.1); }
  .lfaq__scrim {
    position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--color-bg) 72%, transparent) 14%, color-mix(in srgb, var(--color-bg) 72%, transparent) 86%, transparent);
  }
  .lfaq__in { position: relative; }
  .lfaq__title { font-size: clamp(2.4rem, 1.4rem + 4.6vw, 5.5rem); line-height: 1.16; }
  :global([dir='rtl']) .lfaq__title { line-height: 1.34; }
  .lfaq__list { margin-block-start: var(--space-7); border-block-start: 1px solid var(--color-border); }
  .lfaq :global(.faq__item) { border-block-end: 1px solid var(--color-border); }
  .lfaq__q { font: inherit; }
  .lfaq__q button {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-5);
    width: 100%; padding-block: var(--space-5); text-align: start;
    font-family: var(--font-display); font-weight: var(--weight-bold); font-size: var(--text-lg); line-height: 1.5;
  }
  .lfaq__q button:hover { color: var(--color-link); }
  .lfaq__q svg { flex: none; fill: none; stroke: var(--color-accent); stroke-width: 1.8; stroke-linecap: round; transition: rotate var(--dur-base) var(--ease-out); }
  .lfaq__q button[aria-expanded='true'] svg { rotate: 45deg; }
  :global(html:not(.js)) .lfaq__q svg { display: none; }
  .lfaq__a { padding-block-end: var(--space-5); display: grid; gap: var(--space-3); justify-items: start; }
  .lfaq__a p { max-width: 62ch; line-height: 1.85; color: color-mix(in srgb, var(--color-ink) 90%, transparent); }
  .lfaq__a a { font-size: var(--text-sm); color: var(--color-link); }

  @media (min-width: 1024px) {
    .lfaq__scrim { background: linear-gradient(to right, color-mix(in srgb, var(--color-bg) 88%, transparent) 0%, color-mix(in srgb, var(--color-bg) 70%, transparent) 50%, transparent 78%); }
    :global([dir='rtl']) .lfaq__scrim { background: linear-gradient(to left, color-mix(in srgb, var(--color-bg) 88%, transparent) 0%, color-mix(in srgb, var(--color-bg) 70%, transparent) 50%, transparent 78%); }
    .lfaq__in { max-width: none; }
    .lfaq__title, .lfaq__list { max-width: 44rem; }
  }
</style>
