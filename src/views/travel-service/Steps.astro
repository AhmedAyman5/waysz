---
/**
 * Travel detail page — how we work, drawn as a journey: a static dashed route with one stop per step (numbers
 * belong here, it is a sequence), a small plane mark where the route starts and the last stop lit as the
 * arrival. Vertical on phones, a row on wide screens. Static SVG + CSS, no scroll animation.
 */
import Bidi from './Bidi.astro';
import { useTranslations, type Lang } from '../../i18n';

interface Props { lang: Lang; steps: { title: string; text: string }[] }
const { lang, steps } = Astro.props;
const t = useTranslations(lang);
const num = (i: number) => new Intl.NumberFormat(lang === 'ar' ? 'ar-EG' : 'en').format(i);
---
{steps.length > 0 && (
  <section class="tst tsp-sec" aria-labelledby="tst-title">
    <h2 class="tsp-h2" id="tst-title" data-split="words">{t.service.steps}</h2>
    <div class="tst__route" data-reveal="up">
      <!-- the plane points to the end of the line: down on phones, toward the reading direction on wide screens -->
      <svg class="tst__plane icon-dir" viewBox="0 0 24 24" width="30" height="30" aria-hidden="true">
        <path d="M21.5 12c0-.8-.7-1.3-1.5-1.3h-4.6L10.6 3.5H8.7l2.3 7.2H6.3L4.5 8.4H3.1l1.1 3.6-1.1 3.6h1.4l1.8-2.3H11l-2.3 7.2h1.9l4.8-7.2H20c.8 0 1.5-.5 1.5-1.3Z" />
      </svg>
      <ol class="tst__list" role="list" style={`--n: ${steps.length}`}>
        {steps.map((s, i) => (
          <li class="tst__step">
            <span class="tst__num" aria-hidden="true">{num(i + 1)}</span>
            <h3 class="tst__name">{s.title}</h3>
            <p class="tst__text"><Bidi text={s.text} lang={lang} /></p>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

<style is:inline>
  .tst__route { position: relative; margin-block-start: var(--space-7); padding-block-start: 52px; }
  /* the route: a dashed line from the plane to the last stop */
  .tst__route::before {
    content: ''; position: absolute; inset-block: 38px 24px; inset-inline-start: 19px;
    border-inline-start: 2px dashed color-mix(in srgb, var(--color-area-travel) 60%, transparent);
  }
  .tst__plane { position: absolute; inset-block-start: 0; inset-inline-start: 5px; fill: var(--color-area-travel); rotate: 90deg; }
  [dir='rtl'] .tst__plane { rotate: -90deg; }   /* .icon-dir has already mirrored it */
  .tst__list { position: relative; display: grid; gap: var(--space-6); }
  .tst__step { display: grid; grid-template-columns: 40px 1fr; column-gap: var(--space-4); }
  .tst__num {
    grid-row: span 2; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%;
    background: var(--color-bg); border: 2px solid var(--color-area-travel); color: var(--color-area-travel);
    box-shadow: 0 0 0 6px var(--color-bg);
    font-family: var(--font-display); font-weight: var(--weight-bold); font-size: var(--text-sm);
  }
  .tst__step:last-child .tst__num { background: var(--color-area-travel); color: var(--color-on-accent); box-shadow: 0 0 0 6px var(--color-bg), 0 0 24px 4px color-mix(in srgb, var(--color-area-travel) 45%, transparent); }
  .tst__name { align-self: center; font-size: var(--text-lg); font-weight: var(--weight-bold); line-height: 1.4; }
  .tst__text { grid-column: 2; margin-block-start: var(--space-2); color: var(--color-ink-muted); line-height: 1.75; }
  @media (min-width: 1024px) {
    .tst__route { padding-block-start: 0; padding-inline-start: 64px; }
    .tst__route::before { inset-block: 19px auto; inset-inline: 40px 20px; border-inline-start: 0; border-block-start: 2px dashed color-mix(in srgb, var(--color-area-travel) 60%, transparent); }
    .tst__plane, [dir='rtl'] .tst__plane { inset-block-start: 5px; inset-inline-start: 0; rotate: none; }
    .tst__list { grid-template-columns: repeat(var(--n), 1fr); gap: var(--space-5); }
    .tst__step { grid-template-columns: 1fr; row-gap: var(--space-4); align-content: start; }
    .tst__num { grid-row: auto; }
    .tst__text { grid-column: 1; margin-block-start: 0; }
  }
</style>
