---
/**
 * Travel detail page — «خدمات الهجرة والدراسة والتأشيرات»: the eight services of brief §2.2 in the brief's order,
 * card text from the one source (serviceCards). Each card behaves exactly as on the Immigration page:
 *   a service with a detail page → its page (the current one: aria-current="page")
 *   visa-services → WaysZ Visa (site.visaSite), sky accent like the boarding pass
 *   every other service → «اطلب استشارة», the consultation call at the end of the Immigration page
 */
import { serviceCards, GROUP_PAGE } from '../../data/services';
import { TRAVEL_ICONS, TRAVEL_ICON_OF } from './icons';
import { site } from '../../lib/site';
import { localizePath, useTranslations, type Lang } from '../../i18n';

interface Props { lang: Lang; current: string }
const { lang, current } = Astro.props;
const t = useTranslations(lang);
const items = (await serviceCards(lang, 'travel')).map((s) => {
  const here = s.slug === current;
  const link =
    s.external ? { href: site.visaSite, label: t.cta.visitVisa, rel: 'noopener', kind: 'visa' }
    : here ? { href: localizePath(`/services/${s.slug}/`, lang), label: t.travelService.current, kind: 'here' }
    : s.page ? { href: localizePath(`/services/${s.slug}/`, lang), label: t.cta.details, kind: 'page' }
    : { href: `${localizePath(GROUP_PAGE.travel, lang)}#consult`, label: t.cta.consult, kind: 'consult' };
  return { ...s, here, link };
});
const arrow = '<path d="M5 12h14m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>';
const external = '<path d="M8 16 16 8M9.5 8H16v6.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>';
---
<section class="tsa" aria-labelledby="tsa-title">
  <div class="container">
    <h2 class="tsp-h2" id="tsa-title" data-split="words">{t.travelService.services}</h2>
    <p class="tsa__lead">{t.travelService.servicesLead}</p>
    <ul class="tsa__grid" role="list" data-reveal="up">
      {items.map((s) => (
        <li class:list={['tsa__card', { 'is-here': s.here }]} data-site={s.external ? 'visa' : undefined}>
          <svg class="tsa__icon" viewBox="0 0 48 48" width="44" height="44" aria-hidden="true" set:html={TRAVEL_ICONS[TRAVEL_ICON_OF[s.slug]]} />
          <h3 class="tsa__name">{s.name}</h3>
          <p class="tsa__text">{s.text}</p>
          <a class={`tsa__link tsa__link--${s.link.kind}`} href={s.link.href} rel={s.link.rel}
             aria-current={s.here ? 'page' : undefined} aria-label={`${s.link.label}: ${s.name}`}>
            <span>{s.link.label}</span>
            {s.link.kind === 'page' && <svg class="icon-dir" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" set:html={arrow} />}
            {s.link.kind === 'visa' && <svg class="icon-dir" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" set:html={external} />}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style is:inline>
  .tsa { padding-block: var(--section-y); background: var(--color-bg-alt); }
  .tsa__lead { margin-block-start: var(--space-4); max-width: 62ch; line-height: 1.8; color: var(--color-ink-muted); }
  .tsa__grid { display: grid; gap: var(--space-4); margin-block-start: var(--space-7); grid-template-columns: 1fr; }
  @media (min-width: 640px) { .tsa__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .tsa__grid { grid-template-columns: repeat(4, 1fr); } }
  .tsa__card {
    position: relative; display: flex; flex-direction: column;
    padding: var(--space-6); border-radius: var(--radius-md);
    background: var(--color-surface); border: 1px solid var(--color-border);
    transition: border-color var(--dur-fast) var(--ease-out), translate var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }
  .tsa__card:hover { border-color: color-mix(in srgb, var(--color-accent) 70%, transparent); translate: 0 -3px; box-shadow: 0 18px 40px rgb(0 0 0 / 0.28); }
  .tsa__icon { overflow: visible; fill: none; stroke: var(--color-accent); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .tsa__name { margin-block-start: var(--space-5); font-size: var(--text-lg); font-weight: var(--weight-bold); line-height: 1.4; }
  .tsa__text { margin-block: var(--space-3) var(--space-5); font-size: var(--text-sm); line-height: 1.75; color: var(--color-ink-muted); }
  .tsa__link {
    margin-block-start: auto; align-self: start; display: inline-flex; align-items: center; gap: var(--space-2);
    min-height: 44px; font-family: var(--font-display); font-weight: var(--weight-bold); font-size: var(--text-sm);
    text-decoration: none; color: var(--color-ink);
  }
  .tsa__link span { border-block-end: 1.5px solid var(--color-accent); padding-block: 2px; }
  .tsa__link:hover { color: var(--color-accent); }
  .tsa__link svg { flex: none; transition: translate var(--dur-base) var(--ease-out); }
  .tsa__link--page:hover svg { translate: 4px 0; }
  [dir='rtl'] .tsa__link--page:hover svg { translate: -4px 0; }
  /* «اطلب استشارة»: an outlined pill, so the call reads differently from a link to a page */
  .tsa__link--consult { padding-inline: var(--space-5); border: 1.5px solid color-mix(in srgb, var(--color-ink) 40%, transparent); border-radius: var(--radius-pill); }
  .tsa__link--consult span { border: 0; }
  .tsa__link--consult:hover { border-color: var(--color-accent); }
  /* the current service: lit with the horizon amber, its link is a quiet label */
  .tsa__card.is-here { border-color: var(--color-area-travel); background: color-mix(in srgb, var(--color-area-travel) 10%, var(--color-surface)); }
  .tsa__card.is-here:hover { translate: none; box-shadow: none; }
  .tsa__link--here { color: var(--color-area-travel); }
  .tsa__link--here span { border: 0; }
  .tsa__link--here::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
</style>
