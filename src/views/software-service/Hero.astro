---
/**
 * Software detail page — hero (theme-dark). A full-bleed photo of the service behind a navy gradient (AA), the
 * breadcrumb, the area label, the service name (words rise), the description and the call buttons. Wide screens:
 * a small STATIC block of decorative code beside the text (our own lines; dir="ltr", aria-hidden, system
 * monospace, never mirrored, no character animation — CLAUDE.md, decorative code). It is not views/software/
 * Code.astro: that component ships an is:global stylesheet, which would be linked from every detail page.
 * The photo fills the screen on phones too, so the description stays the largest paint (LCP). No WebGL, no pin.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Bidi from './Bidi.astro';
import { GROUP_PAGE } from '../../data/services';
import { site, waHref } from '../../lib/site';
import { localizePath, useTranslations, type Lang } from '../../i18n';

/** one line of decorative code: [token kind, text] pairs (k keyword · f function · s string · p punctuation · c comment · i name) */
export type CodeLine = [string, string][];
interface Props { lang: Lang; name: string; description: string; photo: ImageMetadata; alt: string; focus?: string; code?: CodeLine[] }
const { lang, name, description, photo, alt, focus = '50% 50%', code = [] } = Astro.props;
const t = useTranslations(lang);
const chevron = '<path d="m9 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>';
---
<section class="ssh" aria-labelledby="ssh-title">
  <div class="ssh__media">
    <Image src={photo} alt={alt} widths={[640, 960, 1440, 1920, 2400]} sizes="100vw" format="webp" quality={62}
           loading="eager" fetchpriority="high" decoding="async" style={`object-position: ${focus}`} />
  </div>
  <div class="ssh__scrim" aria-hidden="true"></div>

  <div class="ssh__in container">
    <div class="ssh__content">
      <nav class="ssh__crumb" aria-label={t.nav.services}>
        <a href={localizePath('/services/', lang)}>{t.nav.services}</a>
        <svg class="icon-dir" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" set:html={chevron} />
        <a href={localizePath(GROUP_PAGE.software, lang)}>{t.areas.software}</a>
        <svg class="icon-dir" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" set:html={chevron} />
        <span aria-current="page">{name}</span>
      </nav>
      <p class="ssh__area"><span class="ssh__mark" aria-hidden="true"></span>{t.areas.software}</p>
      <h1 class="ssh__title" id="ssh-title" data-split="words">{name}</h1>
      <p class="ssh__lead"><Bidi text={description} lang={lang} /></p>
      <div class="ssh__actions">
        <a class="btn btn--accent" href={localizePath('/contact/', lang)}>{t.cta.consult}</a>
        {site.whatsapp && (
          <a class="btn btn--ghost" href={waHref(site.whatsapp, `${t.whatsapp.message}${name}`)} target="_blank" rel="noopener">{t.cta.whatsapp}</a>
        )}
      </div>
    </div>

    {code.length > 0 && (
      <pre class="ssh__code" dir="ltr" aria-hidden="true">{code.map((line) => (
        <span class="ssh__ln">{line.map(([kind, text]) => <span class={`ssh__t-${kind}`}>{text}</span>)}</span>
      ))}</pre>
    )}
  </div>
</section>

<style is:inline>
  .ssh {
    position: relative; overflow: clip; isolation: isolate;
    min-height: 100vh; min-height: 100svh;
    display: grid; align-items: end;
  }
  @media (min-width: 1024px) { .ssh { min-height: 88vh; min-height: 88svh; } }
  .ssh__media, .ssh__scrim { position: absolute; inset: 0; z-index: -1; }
  .ssh__media img { width: 100%; height: 100%; object-fit: cover; }
  /* the text always sits on this gradient: AA on the brightest part of the photo (the lamp) */
  .ssh__scrim {
    background:
      linear-gradient(to top, var(--color-bg) 0%, color-mix(in srgb, var(--color-bg) 90%, transparent) 32%, color-mix(in srgb, var(--color-bg) 58%, transparent) 62%, color-mix(in srgb, var(--color-bg) 30%, transparent) 100%),
      linear-gradient(to bottom, color-mix(in srgb, var(--color-bg) 70%, transparent), transparent 22%);
  }
  .ssh__in { display: grid; gap: var(--space-7); align-items: end; padding-block: calc(76px + var(--space-7)) var(--space-8); }
  .ssh__content { min-width: 0; }
  .ssh__crumb { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); font-size: var(--text-sm); color: color-mix(in srgb, var(--color-ink) 84%, transparent); }
  .ssh__crumb a { text-decoration: none; }
  .ssh__crumb a:hover { color: var(--color-link); text-decoration: underline; }
  .ssh__area {
    display: flex; align-items: center; gap: var(--space-3); margin-block-start: var(--space-6);
    font-family: var(--font-display); font-weight: var(--weight-bold); font-size: var(--text-sm); color: var(--color-area-software);
  }
  .ssh__mark { width: 28px; height: 1.5px; background: currentColor; }
  .ssh__title {
    margin-block-start: var(--space-3); max-width: 16ch;
    font-size: clamp(2.4rem, 1.2rem + 4.8vw, 5.6rem); line-height: 1.1; letter-spacing: -0.015em;
  }
  [dir='rtl'] .ssh__title { line-height: 1.32; letter-spacing: 0; }
  .ssh__lead { margin-block-start: var(--space-5); max-width: 60ch; font-size: var(--text-lg); line-height: 1.8; color: color-mix(in srgb, var(--color-ink) 92%, transparent); }
  .ssh__actions { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-block-start: var(--space-7); }
  .ssh__actions .btn { min-height: 54px; padding-inline: var(--space-7); font-size: var(--text-base); white-space: normal; text-align: center; }
  @media (max-width: 639px) {
    .ssh__lead { font-size: var(--text-base); }
    .ssh__actions .btn { flex: 1 1 100%; }
  }

  /* the decorative code: wide screens only, beside the text, never mirrored */
  .ssh__code { display: none; }
  @media (min-width: 1200px) {
    .ssh__in { grid-template-columns: minmax(0, 1fr) auto; }
    .ssh__code {
      display: block; margin: 0 0 var(--space-3); padding: var(--space-5) var(--space-6);
      direction: ltr; text-align: left; unicode-bidi: isolate; white-space: pre;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 0.95rem; line-height: 1.75; font-weight: 400;
      font-variant-ligatures: none; letter-spacing: 0; tab-size: 2;
      color: color-mix(in srgb, var(--color-ink) 82%, var(--color-ink-muted));
      background: color-mix(in srgb, var(--color-bg) 72%, transparent);
      border: 1px solid color-mix(in srgb, var(--color-area-software) 28%, transparent); border-radius: var(--radius-md);
      box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-bg) 40%, transparent), 0 30px 60px -30px color-mix(in srgb, var(--color-area-software) 30%, transparent);
    }
    .ssh__ln { display: block; min-height: 1.75em; }
    .ssh__t-k { color: var(--color-accent); }
    .ssh__t-f { color: var(--color-area-software); }
    .ssh__t-s { color: color-mix(in srgb, var(--color-area-software) 55%, var(--color-ink)); }
    .ssh__t-c, .ssh__t-p { color: var(--color-ink-muted); }
  }
</style>
