---
/**
 * Immigration page — hero. Scene: motion/scenes/page-hero.ts.
 * Dusk from the window seat (real footage, no livery): the page title staged huge, the group intro of
 * brief §2.2 as the lead. Sticky + scrubbed (no pin): scrolling closes the view into a cabin-window shape
 * that falls back into the night, where the route of the next section starts.
 * The lead and the buttons are painted at once (LCP); only the headline is staged.
 */
import BgVideo from '../../components/BgVideo.astro';
import { localizePath, useTranslations, type Lang } from '../../i18n';

interface Props { lang: Lang; lead: string }
const { lang, lead } = Astro.props;
const t = useTranslations(lang);
// the area name, broken where it reads best when it is this large
const title = { ar: ['الهجرة والدراسة', 'والتأشيرات'], en: ['Immigration,', 'Study & Visas'] }[lang];
---
<section class="phero theme-dark" data-scene="page-hero" data-depth-scene data-waypoint aria-labelledby="phero-title">
  <div class="phero__sticky">
    <div class="phero__window" aria-hidden="true">
      <div class="phero__plate" data-depth="0.25">
        <BgVideo name="travel-dusk" mobile="travel-dusk-m" eager focus="64% 50%" />
      </div>
      <div class="phero__scrim"></div>
    </div>

    <div class="phero__content container">
      <nav class="phero__crumb" aria-label={t.nav.services}>
        <a href={localizePath('/services/', lang)}>{t.nav.services}</a>
        <svg class="icon-dir" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="m9 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span aria-current="page">{t.areas.travel}</span>
      </nav>
      <h1 class="phero__title" id="phero-title" data-intro>
        {title.map((line) => <span class="phero__line">{line}{' '}</span>)}
      </h1>
      <p class="phero__lead">{lead}</p>
      <div class="phero__actions">
        <a class="btn btn--accent" href="#consult" data-magnetic>{t.cta.consult}</a>
        <a class="btn btn--ghost" href="#services">{t.cta.explore}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .phero { position: relative; }
  .phero__sticky {
    position: relative; overflow: hidden;
    height: 100vh; height: 100svh; min-height: 36rem;
    display: grid; align-items: end;
  }
  /* scroll room for the window to close — only when the scene can run */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .phero { height: 165vh; height: 165lvh; }
    :global(.js) .phero__sticky { position: sticky; top: 0; height: 100vh; height: 100lvh; }
    :global(.js) .phero__content { padding-block-end: calc(100lvh - 100svh + var(--space-8)); }
  }
  .phero__window, .phero__scrim { position: absolute; inset: 0; }
  .phero__window { overflow: hidden; will-change: clip-path; }
  .phero__plate { position: absolute; inset: -4%; }
  /* text always sits on this gradient (AA on the brightest part of the horizon) */
  .phero__scrim {
    background:
      linear-gradient(to top, color-mix(in srgb, var(--color-bg) 94%, transparent) 0%, color-mix(in srgb, var(--color-bg) 70%, transparent) 34%, transparent 70%),
      linear-gradient(to bottom, color-mix(in srgb, var(--color-bg) 55%, transparent), transparent 26%);
  }

  .phero__content { position: relative; padding-block: calc(76px + var(--space-6)) var(--space-8); }
  .phero__crumb { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); color: color-mix(in srgb, var(--color-ink) 80%, transparent); }
  .phero__crumb a { text-decoration: none; }
  .phero__crumb a:hover { color: var(--color-link); }
  .phero__title {
    margin-block-start: var(--space-4);
    font-size: clamp(2.7rem, 1rem + 7.4vw, 8.25rem); line-height: 1.1; letter-spacing: -0.015em;
  }
  :global([dir='rtl']) .phero__title { letter-spacing: 0; line-height: 1.28; }
  .phero__line { display: block; }
  .phero__lead {
    margin-block-start: var(--space-5); max-width: 62ch;
    font-size: var(--text-lg); line-height: 1.75; color: color-mix(in srgb, var(--color-ink) 88%, transparent);
  }
  .phero__actions { display: flex; flex-wrap: wrap; gap: var(--space-4); margin-block-start: var(--space-6); }
  .phero__actions .btn { min-height: 54px; padding-inline: var(--space-7); font-size: var(--text-base); }
  @media (max-width: 639px) {
    .phero__lead { font-size: var(--text-base); }
    .phero__actions .btn { flex: 1 1 100%; }
  }
</style>
