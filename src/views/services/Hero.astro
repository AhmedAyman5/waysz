---
/**
 * Services page — hero: the whole sky. Scene: motion/scenes/services-hero.ts · the sky is the stage act `sky`
 * (views/ServicesPage.astro: one stage host for the whole page).
 * The huge «خدماتنا» and the §2 intro stand in the middle of the night sky while the scattered stars gather into the
 * four constellations. Both are painted at once and never hidden (LCP); the title only settles. A tall section with a
 * sticky screen (no pin): scrolling lets the text leave as the camera drifts closer.
 */
import type { Lang } from '../../i18n';

interface Props { lang: Lang; title: string }
const { lang, title } = Astro.props;
// brief §2 «النص التعريفي» (Arabic is the source; English is a faithful translation)
const lead = {
  ar: 'مجموعة متكاملة من الخدمات القانونية، وخدمات الهجرة والدراسة والتأشيرات، وتنظيم المعارض والمؤتمرات الدولية، والحلول التقنية؛ مصممة لتلبي احتياجات الأفراد والشركات والجهات بأعلى درجات المهنية والوضوح.',
  en: 'A complete range of legal services, immigration, study and visa services, international exhibition and conference organizing, and technology solutions — designed to meet the needs of individuals, companies and organizations with the highest standards of professionalism and clarity.',
}[lang];
---
<section class="shero" data-scene="services-hero" data-waypoint aria-labelledby="shero-title">
  <div class="shero__sticky" data-sky-pad>
    <div class="shero__pool" aria-hidden="true"></div>
    <div class="shero__content container">
      <h1 class="shero__title" id="shero-title">{title}</h1>
      <p class="shero__lead">{lead}</p>
    </div>
    <a class="shero__cue" href="#directory" aria-label={title}><span aria-hidden="true"></span></a>
  </div>
</section>

<style>
  .shero { position: relative; }
  .shero__sticky {
    position: relative; overflow: clip;
    min-height: 100vh; min-height: 100svh;
    display: grid; place-items: center;
  }
  :global(.js) .shero { height: 165vh; height: 165lvh; }
  :global(.js) .shero__sticky { position: sticky; top: 0; height: 100vh; height: 100lvh; }

  /* a soft pool of night under the text: AA on any star, the sky stays visible around it */
  .shero__pool {
    position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(ellipse 52% 40% at 50% 52%, color-mix(in srgb, var(--color-bg) 62%, transparent) 0%, color-mix(in srgb, var(--color-bg) 24%, transparent) 64%, transparent 100%),
      linear-gradient(to bottom, color-mix(in srgb, var(--color-bg) 66%, transparent) 0%, transparent 20%);
  }
  @media (max-width: 1023px) {
    .shero__pool { background:
      radial-gradient(ellipse 90% 42% at 50% 52%, color-mix(in srgb, var(--color-bg) 70%, transparent) 0%, color-mix(in srgb, var(--color-bg) 30%, transparent) 66%, transparent 100%),
      linear-gradient(to bottom, color-mix(in srgb, var(--color-bg) 66%, transparent) 0%, transparent 20%); }
  }

  .shero__content {
    position: relative; z-index: 1; text-align: center;
    display: grid; justify-items: center;
    padding-block: calc(76px + var(--space-6)) var(--space-9);
  }
  .shero__title {
    font-size: clamp(3.4rem, 0.6rem + 12vw, 13rem); line-height: 1; letter-spacing: -0.035em;
    text-shadow: 0 4px 60px color-mix(in srgb, var(--color-bg) 80%, transparent);
    will-change: transform;
  }
  :global([dir='rtl']) .shero__title { letter-spacing: 0; line-height: 1.2; }
  .shero__lead {
    margin-block-start: var(--space-6); max-width: 58ch;
    font-size: var(--text-lg); line-height: 1.85; color: color-mix(in srgb, var(--color-ink) 92%, transparent);
    text-shadow: 0 1px 18px var(--color-bg);
  }
  @media (max-width: 639px) { .shero__lead { font-size: var(--text-base); } }

  /* scroll cue: a falling star on a thread */
  .shero__cue { position: absolute; inset-block-end: var(--space-6); inset-inline-start: 50%; translate: -50% 0; width: 44px; height: 64px; display: grid; justify-items: center; }
  .shero__cue span { position: relative; width: 1px; height: 100%; overflow: hidden; background: color-mix(in srgb, var(--color-ink) 18%, transparent); }
  .shero__cue span::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to bottom, transparent, var(--color-ink), transparent); animation: shero-cue 2.4s var(--ease-in-out) infinite; }
  @keyframes shero-cue { from { translate: 0 -100%; } to { translate: 0 100%; } }
  :global(html:not(.js)) .shero__cue { display: none; }
</style>
