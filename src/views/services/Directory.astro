---
/**
 * Services page — the directory: tabs + the four areas with all 30 services (brief §2, §2.1–§2.4).
 * Scene: motion/scenes/services-directory.ts.
 *   - the tabs (الكل · القانونية · …) are plain links without JS (#legal …); with JS they become an ARIA tab list that
 *     filters the areas (GSAP Flip, never a hard cut), keeps ?area= in the URL and opens the tab the header asks for.
 *     The bar sticks under the header; a beam marks the selected tab, or, under «الكل», the area you are reading.
 *   - each area: a sticky side column (wide screens) whose top is a window on the sky — the stage act `sky` flies to
 *     that area's constellation and draws it there (`.area__sky` is the box it frames) — with the area's intro and the
 *     link to its group page; beside it the cards, laid out differently per area (plaques · boarding strips ·
 *     a staggered programme · code windows). Legal adds its sub-specialties (chips that light in sequence),
 *     Events its kinds of events (a slow double marquee).
 *   - a card under the pointer / keyboard focus lights its own star in the sky (`data-star`, order of
 *     src/data/services.ts); clicking a star brings its card.
 * Cards link to /services/<slug>/ when that service file exists, otherwise to the area's group page; the visa
 * card goes to WaysZ Visa (as on the Immigration page). No JS: every area and all 30 cards, grouped, readable.
 */
import { site } from '../../lib/site';
import { AREAS, AREA_INTRO, GROUP_PAGE, type Area, type ServiceCard } from '../../data/services';
import { localizePath, useTranslations, type Lang } from '../../i18n';
import { EMBLEM } from './emblems';

interface Props { lang: Lang; cards: ServiceCard[] }
const { lang, cards } = Astro.props;
const t = useTranslations(lang);
const s = t.servicesPage;

const mark = (key: keyof typeof EMBLEM) => EMBLEM[key].replaceAll('<path ', '<path pathLength="1" ');
const link = (c: ServiceCard) =>
  c.external ? { href: site.visaSite, label: t.cta.visitVisa, rel: 'noopener' }
  : { href: localizePath(c.page ? `/services/${c.slug}/` : GROUP_PAGE[c.area], lang), label: t.cta.details };

// brief §2.1 «كيف يمكننا مساعدتك؟» and §2.3 «نوعيات الفعاليات التي ننظمها» — names only, the brief's order
const extra = {
  ar: {
    help: ['التقاضي أمام المحاكم', 'صياغة العقود ومراجعتها', 'قضايا العمل والعمال', 'القانون العقاري', 'الملكية الفكرية', 'حماية البيانات', 'التحكيم التجاري', 'تأسيس الشركات', 'تنفيذ الأحكام'],
    types: ['مؤتمرات علمية وطبية', 'مؤتمرات حكومية ودبلوماسية', 'منتديات الأعمال والاستثمار', 'معارض تجارية وصناعية', 'معارض التعليم الدولي والتوظيف', 'إطلاق المنتجات', 'الاجتماعات السنوية للشركات', 'ورش العمل والندوات'],
  },
  en: {
    help: ['Court litigation', 'Contract drafting and review', 'Labor and employment cases', 'Real-estate law', 'Intellectual property', 'Data protection', 'Commercial arbitration', 'Company formation', 'Enforcement of judgments'],
    types: ['Scientific & medical conferences', 'Government & diplomatic conferences', 'Business & investment forums', 'Trade & industrial exhibitions', 'International education & careers fairs', 'Product launches', 'Annual company meetings', 'Workshops & seminars'],
  },
}[lang];
const rows = [extra.types.slice(0, 4), extra.types.slice(4)];
const tabs: (Area | 'all')[] = ['all', ...AREAS];
const label = (a: Area | 'all') => (a === 'all' ? s.all : s.tabs[a]);
---
<section class="dir" id="directory" data-scene="services-directory" aria-labelledby="dir-title">
  <h2 class="visually-hidden" id="dir-title">{t.nav.services}</h2>
  <div class="dir__bar">
    <nav class="tabs container" aria-label={s.label}>
      <ul class="tabs__list" role="list">
        {tabs.map((a) => (
          <li class="tabs__item">
            <a class="tab" href={a === 'all' ? '#directory' : `#${a}`} data-area={a}>
              <svg class="tab__icon" viewBox="0 0 48 48" width="22" height="22" aria-hidden="true" set:html={EMBLEM[a]} />
              <span>{label(a)}</span>
              {a === 'all' && <span class="tabs__beam" aria-hidden="true"><i></i></span>}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="dir__panel" id="services-panel">
    {AREAS.map((area) => {
      const list = cards.map((c, i) => ({ ...c, star: i })).filter((c) => c.area === area);
      return (
        <section class:list={['area', `area--${area}`]} id={area} data-area={area} data-waypoint aria-labelledby={`area-${area}`}>
          <div class="area__in container">
            <div class="area__side">
              <div class="area__sky" data-sky-pad aria-hidden="true">
                <!-- our own render of this constellation: only the css tier (no WebGL) and no-JS show it -->
                <img class="area__still" data-src={`/media/img/sky-${area}.webp`} alt="" width="720" height="720" loading="lazy" decoding="async" />
                <noscript><img class="area__still" src={`/media/img/sky-${area}.webp`} alt="" width="720" height="720" loading="lazy" decoding="async" /></noscript>
              </div>
              <div class="area__text">
                <svg class="area__mark" viewBox="0 0 48 48" width="40" height="40" aria-hidden="true" set:html={EMBLEM[area]} />
                <h2 class="area__name" id={`area-${area}`}>{t.areas[area]}</h2>
                <p class="area__intro">{AREA_INTRO[area][lang]}</p>
                <a class="area__link link-arrow" href={localizePath(GROUP_PAGE[area], lang)}>
                  {s.explore[area]}
                  <svg class="icon-dir" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              </div>
            </div>

            <div class="area__main">
              <ul class:list={['cards', `cards--${area}`]} role="list">
                {list.map((c) => {
                  const l = link(c);
                  return (
                    <li class="svc" data-star={c.star} data-area={area}>
                      {area === 'software' && <span class="svc__bar" aria-hidden="true"><i></i><i></i><i></i></span>}
                      <svg class="svc__mark" viewBox="0 0 48 48" width="36" height="36" aria-hidden="true" set:html={mark(area)} />
                      <h3 class="svc__name">{c.name}</h3>
                      <p class="svc__text">{c.text}</p>
                      <a class="svc__more" href={l.href} rel={l.rel}>
                        {l.label}<span class="visually-hidden"> — {c.name}</span>
                        <svg class="icon-dir" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      </a>
                    </li>
                  );
                })}
              </ul>

              {area === 'legal' && (
                <div class="extra" aria-labelledby="help-title">
                  <h3 class="extra__title" id="help-title">{s.help}</h3>
                  <ul class="chips" role="list">
                    {extra.help.map((name) => <li class="chip">{name}</li>)}
                  </ul>
                </div>
              )}

              {area === 'events' && (
                <div class="extra" aria-labelledby="types-title">
                  <h3 class="extra__title" id="types-title">{s.types}</h3>
                  <ul class="visually-hidden">{extra.types.map((name) => <li>{name}</li>)}</ul>
                  <div class="marquee" aria-hidden="true">
                    {rows.map((row, r) => (
                      <div class:list={['marquee__row', { 'marquee__row--back': r === 1 }]}>
                        <div class="marquee__track">
                          {[0, 1].map(() => row.map((name) => (
                            <span class="marquee__item"><svg viewBox="0 0 48 48" width="14" height="14" set:html={EMBLEM.all} />{name}</span>
                          )))}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </div>
        </section>
      );
    })}
  </div>
</section>

<style>
  .dir { position: relative; }

  /* ---------- the tab bar (sticky under the header) ---------- */
  .dir__bar {
    position: sticky; top: 0; z-index: var(--z-sticky);
    padding-block: var(--space-3);
    background: color-mix(in srgb, var(--color-bg) 95%, transparent);
    border-block-end: 1px solid var(--color-border);
    --here: var(--color-accent);
    transition: translate var(--dur-base) var(--ease-out);
  }
  .dir__bar[data-here='legal'] { --here: var(--color-area-legal); }
  .dir__bar[data-here='travel'] { --here: var(--color-area-travel); }
  .dir__bar[data-here='events'] { --here: var(--color-area-events); }
  .dir__bar[data-here='software'] { --here: var(--color-area-software); }
  /* the header comes back on the way up: the bar steps down under it */
  :global(html:has(.site-header.is-solid:not(.is-hidden))) .dir__bar { translate: 0 76px; }
  :global(html:not(.js)) .dir__bar { position: relative; }

  .tabs__list {
    list-style: none; display: flex; gap: var(--space-2); overflow-x: auto; scrollbar-width: none;
    padding-block: var(--space-1); margin-inline: calc(-1 * var(--space-1)); padding-inline: var(--space-1);
  }
  .tabs__list::-webkit-scrollbar { display: none; }
  .tabs__item { flex: none; }
  .tab {
    position: relative; display: inline-flex; align-items: center; gap: var(--space-2);
    min-height: 48px; padding-inline: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border); border-radius: var(--radius-pill);
    font-family: var(--font-display); font-weight: var(--weight-semibold); font-size: var(--text-sm);
    color: color-mix(in srgb, var(--color-ink) 78%, transparent); text-decoration: none; white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }
  .tab:hover { color: var(--color-ink); border-color: color-mix(in srgb, var(--color-ink) 40%, transparent); }
  .tab[aria-selected='true'] { color: var(--color-ink); border-color: var(--here); background: color-mix(in srgb, var(--here) 14%, transparent); }
  .tab__icon { flex: none; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .tab[aria-selected='true'] .tab__icon { stroke: var(--here); }
  /* the beam: a line of light with a star on it, moved from tab to tab with Flip */
  .tabs__beam { position: absolute; inset-inline: 18%; inset-block-end: -1px; height: 2px; pointer-events: none; }
  .tabs__beam i {
    position: absolute; inset: 0; border-radius: 2px;
    background: linear-gradient(90deg, transparent, var(--here), transparent);
    box-shadow: 0 0 12px var(--here);
    transition: background-color var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }
  .tabs__beam i::after {
    content: ''; position: absolute; inset-inline-start: 50%; top: 50%; width: 7px; height: 7px; translate: -50% -50%; rotate: 45deg;
    background: var(--color-ink); box-shadow: 0 0 10px 2px var(--here);
  }
  :global(html:not(.js)) .tabs__beam { display: none; }

  /* ---------- an area ---------- */
  .area { position: relative; padding-block: var(--section-y); --area: var(--color-accent); }
  .area--legal { --area: var(--color-area-legal); }
  .area--travel { --area: var(--color-area-travel); }
  .area--events { --area: var(--color-area-events); }
  .area--software { --area: var(--color-area-software); }
  .area + .area { border-block-start: 1px solid color-mix(in srgb, var(--color-ink) 8%, transparent); }
  .area__in { display: grid; gap: var(--space-6); }
  .area__sky { position: relative; height: 34vh; height: 34svh; min-height: 200px; display: grid; place-items: center; }
  .area__still { display: none; width: auto; height: 100%; max-width: 100%; object-fit: contain; }
  :global(html[data-tier='css']) .area__still, :global(html:not(.js)) .area__still { display: block; }
  .area__text {
    position: relative; display: grid; justify-items: start; gap: var(--space-4);
  }
  .area__mark { fill: none; stroke: var(--area); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .area__name { font-size: clamp(2rem, 1.3rem + 3vw, 3.6rem); line-height: 1.15; letter-spacing: -0.01em; }
  :global([dir='rtl']) .area__name { line-height: 1.35; letter-spacing: 0; }
  .area__intro { max-width: 48ch; font-size: var(--text-lg); line-height: 1.8; color: color-mix(in srgb, var(--color-ink) 88%, transparent); }
  .area__link { color: var(--color-link); font-size: var(--text-base); }

  @media (min-width: 1024px) {
    .area__in { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2.5rem, 1rem + 4vw, 6rem); align-items: start; }
    .area__side { position: sticky; top: calc(76px + var(--space-6)); }
    .area__sky { height: 36vh; height: 36svh; }
  }
  @media (max-width: 639px) { .area__intro { font-size: var(--text-base); } }

  /* ---------- cards (one rhythm per area) ---------- */
  .cards { display: grid; gap: var(--space-4); }
  .svc {
    position: relative; display: grid; align-content: start; gap: var(--space-3);
    padding: var(--space-6);
    border: 1px solid var(--color-border); border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-bg) 84%, transparent);
    transition: border-color var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);
  }
  .svc:hover, .svc:focus-within, .svc.is-lit {
    border-color: color-mix(in srgb, var(--area) 70%, transparent);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--area) 30%, transparent), 0 18px 50px -20px color-mix(in srgb, var(--area) 45%, transparent);
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
  }
  .svc.is-picked { animation: svc-picked 1.4s var(--ease-out); }
  @keyframes svc-picked { 0%, 30% { box-shadow: 0 0 0 2px var(--area), 0 0 60px -6px var(--area); } }
  .svc__mark { fill: none; stroke: var(--area); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .svc__mark :global(path) { stroke-dasharray: 1; stroke-dashoffset: 0; }
  .svc:hover .svc__mark :global(path), .svc:focus-within .svc__mark :global(path), .svc.is-lit .svc__mark :global(path) { animation: svc-draw 1.1s var(--ease-out) both; }
  @keyframes svc-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  .svc__name { font-size: var(--text-lg); line-height: 1.4; }
  .svc__text { font-size: var(--text-sm); line-height: 1.8; color: color-mix(in srgb, var(--color-ink) 82%, transparent); }
  .svc__more {
    display: inline-flex; align-items: center; gap: var(--space-2); width: fit-content; min-height: 44px;
    font-family: var(--font-display); font-weight: var(--weight-semibold); font-size: var(--text-sm);
    color: var(--color-link); text-decoration: none;
  }
  .svc__more:hover { text-decoration: underline; text-underline-offset: 4px; }
  .svc__more svg { transition: translate var(--dur-base) var(--ease-out); }
  .svc__more:hover svg { translate: 4px 0; }
  :global([dir='rtl']) .svc__more:hover svg { translate: -4px 0; }

  /* Legal — engraved plaques: a double frame, the scales in the corner */
  .cards--legal .svc { box-shadow: inset 0 0 0 5px color-mix(in srgb, var(--color-bg) 84%, transparent), inset 0 0 0 6px color-mix(in srgb, var(--area) 26%, transparent); }
  .cards--legal .svc__mark { position: absolute; inset-block-start: var(--space-5); inset-inline-end: var(--space-5); }
  .cards--legal .svc__name { padding-inline-end: var(--space-8); }
  @media (min-width: 640px) { .cards--legal { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  /* Immigration — boarding strips: name | perforation | text, the plane on its route at the end */
  .cards--travel { gap: var(--space-3); }
  .cards--travel .svc { border-radius: var(--radius-sm); }
  @media (min-width: 768px) {
    .cards--travel .svc { grid-template-columns: minmax(0, 13rem) minmax(0, 1fr) auto; align-items: center; column-gap: var(--space-6); padding-block: var(--space-5); }
    .cards--travel .svc__name { grid-column: 1; grid-row: 1 / span 2; }
    .cards--travel .svc__text { grid-column: 2; grid-row: 1; padding-inline-start: var(--space-6); border-inline-start: 1.5px dashed color-mix(in srgb, var(--area) 40%, transparent); }
    .cards--travel .svc__more { grid-column: 2; grid-row: 2; margin-inline-start: var(--space-6); }
    .cards--travel .svc__mark { grid-column: 3; grid-row: 1 / span 2; }
  }

  /* Events — the programme: two staggered columns, a velvet edge on the reading side */
  .cards--events .svc { border-inline-start: 3px solid color-mix(in srgb, var(--area) 75%, transparent); background: linear-gradient(to bottom, color-mix(in srgb, var(--area) 9%, transparent), transparent 46%), color-mix(in srgb, var(--color-bg) 84%, transparent); }
  @media (min-width: 640px) {
    .cards--events { grid-template-columns: repeat(2, minmax(0, 1fr)); padding-block-end: var(--space-8); }
    .cards--events .svc:nth-child(even) { margin-block: var(--space-8) calc(-1 * var(--space-8)); }
  }

  /* Software — code windows */
  .cards--software .svc { padding-block-start: var(--space-8); border-radius: var(--radius-sm); }
  .svc__bar { position: absolute; inset-block-start: 0; inset-inline: 0; display: flex; gap: 6px; align-items: center; height: 32px; padding-inline: var(--space-4); border-block-end: 1px solid var(--color-border); }
  .svc__bar i { width: 8px; height: 8px; border-radius: 50%; background: color-mix(in srgb, var(--color-ink) 22%, transparent); }
  .svc__bar i:first-child { background: color-mix(in srgb, var(--area) 80%, transparent); }
  .cards--software .svc__mark { position: absolute; inset-block-start: 4px; inset-inline-end: var(--space-3); width: 24px; height: 24px; }
  @media (min-width: 640px) { .cards--software { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  /* ---------- extras ---------- */
  .extra { margin-block-start: var(--space-8); display: grid; gap: var(--space-5); }
  .extra__title { font-size: var(--text-xl); }
  .chips { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .chip {
    --lit: 0.3;
    padding: var(--space-2) var(--space-4); border-radius: var(--radius-pill); font-size: var(--text-sm);
    border: 1px solid color-mix(in srgb, var(--area) calc(var(--lit) * 100%), var(--color-border));
    background: color-mix(in srgb, var(--area) calc(var(--lit) * 16%), transparent);
    box-shadow: 0 0 calc(var(--lit) * 22px) color-mix(in srgb, var(--area) calc(var(--lit) * 50%), transparent);
  }

  .marquee { display: grid; gap: var(--space-3); overflow: hidden; mask-image: linear-gradient(90deg, transparent, var(--color-ink) 10%, var(--color-ink) 90%, transparent); }
  .marquee__row { overflow: hidden; }
  .marquee__track { display: flex; width: max-content; animation: marquee 70s linear infinite; }
  .marquee__row--back .marquee__track { animation-direction: reverse; animation-duration: 80s; }
  :global([dir='rtl']) .marquee__track { animation-name: marquee-rtl; }
  .marquee:hover .marquee__track { animation-play-state: paused; }
  .marquee__item {
    display: inline-flex; align-items: center; gap: var(--space-3); padding-inline: var(--space-3) var(--space-5);
    font-family: var(--font-display); font-weight: var(--weight-semibold); font-size: var(--text-lg); white-space: nowrap;
    color: color-mix(in srgb, var(--color-ink) 90%, transparent);
  }
  .marquee__item svg { flex: none; fill: none; stroke: var(--area); stroke-width: 3; }
  @keyframes marquee { to { translate: -50% 0; } }
  @keyframes marquee-rtl { to { translate: 50% 0; } }
</style>
