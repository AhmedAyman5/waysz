  </span>
</div>
<div class="flight-bar" aria-hidden="true"></div>

<style>
  .flight-rail {
    position: fixed;
    inset-block: 18vh;
    inset-inline-end: 18px;
    width: 18px;
    z-index: var(--z-sticky);
    pointer-events: none;
    display: none;
  }
  @media (pointer: fine) and (min-width: 1024px) {
    :global(.js) .flight-rail { display: block; }
  }
  .flight-rail__line {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 50%;
    border-inline-start: 1.5px dashed color-mix(in srgb, var(--color-ink-muted) 45%, transparent);
  }
  .flight-rail__plane { position: absolute; top: 0; inset-inline-start: 0; width: 18px; height: 18px; }
  .flight-rail :global(.flight-rail__tick) {
    position: absolute; inset-inline-start: calc(50% - 4px);
    width: 9px; height: 1.5px;
    background: color-mix(in srgb, var(--color-ink-muted) 70%, transparent);
  }
  .flight-rail :global(.flight-rail__tick:not([style*="top"])) { display: none; }

  .flight-bar {
    position: fixed; inset-inline: 0; top: 0; height: 2px;
    z-index: calc(var(--z-header) + 1);
    background: var(--color-accent);
    transform-origin: 0 50%;
    display: none; pointer-events: none;
  }
  :global([dir='rtl']) .flight-bar { transform-origin: 100% 50%; }
  @media (pointer: coarse), (max-width: 1023px) {
    :global(.js) .flight-bar { display: block; }
  }
  .flight-rail__plane svg {
    width: 100%; height: 100%;
    fill: var(--color-accent);
    transform: rotate(109deg);      /* the logo plane points ~-19°; rotate it to fly downward */
  }
</style>
