---
/** Site header (brief §1.1). Hide/show + solid state: motion/globals/header.ts */
import Logo from './Logo.astro';
import { site } from '../lib/site';
import { languages, localizePath, otherLang, switchLangPath, useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  overlay?: boolean;   // true = transparent over a dark hero until you scroll (home)
}
const { lang, overlay = false } = Astro.props;
const t = useTranslations(lang);
const to = otherLang(lang);
const here = Astro.url.pathname;

const links = [
  { href: localizePath('/', lang), label: t.nav.home },
  { href: localizePath('/services/', lang), label: t.nav.services, sub: true },
  { href: localizePath('/about/', lang), label: t.nav.about },
  { href: localizePath('/contact/', lang), label: t.nav.contact },
];
// §1.1 «قائمة خدماتنا»: the four areas
const groupPage: Partial<Record<string, string>> = { travel: '/services/immigration-study-visa/', software: '/services/software-technology/' };   // areas that have their own page (brief §2.2, §2.4)
const areas = (['legal', 'travel', 'events', 'software'] as const).map((key) => ({
  label: t.areas[key],
  href: groupPage[key] ? localizePath(groupPage[key]!, lang) : `${localizePath('/services/', lang)}#${key}`,
}));
const isCurrent = (href: string) =>
  href === localizePath('/', lang) ? here === href : here.startsWith(href);
---
<header class:list={['site-header theme-dark', { 'site-header--solid': !overlay }]} data-open="false">
  <div class="site-header__inner container">
    <a class="brand" href={localizePath('/', lang)} aria-label={t.a11y.home}>
      <Logo decorative class="brand__mark" />
      <span class="brand__word" aria-hidden="true">WaysZ</span>
    </a>

    <nav id="site-nav" class="site-nav" aria-label={t.nav.label} data-lenis-prevent>
      <ul role="list">
        {links.map((l) => (
          <li class:list={{ 'has-sub': l.sub }}>
            <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
            {l.sub && (
              <ul class="sub" role="list" aria-label={t.nav.services}>
                {areas.map((a) => <li><a href={a.href}>{a.label}</a></li>)}
              </ul>
            )}
          </li>
        ))}
        <li><a href={site.visaSite} rel="noopener">{t.nav.visa}</a></li>
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="lang" href={switchLangPath(here, to)} hreflang={to} lang={to}>{languages[to]}</a>
      <a class="btn btn--accent cta" href={localizePath('/contact/', lang)} data-magnetic>{t.cta.consult}</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav"
              data-label-open={t.nav.menu} data-label-close={t.nav.close}>
        <span class="visually-hidden">{t.nav.menu}</span>
        <span class="menu-toggle__bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<script>
  import { lenis } from '../motion/smooth-scroll';

  const header = document.querySelector<HTMLElement>('.site-header')!;
  const toggle = header.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const label = toggle.querySelector('.visually-hidden')!;

  const setOpen = (open: boolean) => {
    header.dataset.open = String(open);
    toggle.setAttribute('aria-expanded', String(open));
    label.textContent = open ? toggle.dataset.labelClose! : toggle.dataset.labelOpen!;
    document.documentElement.classList.toggle('menu-open', open);
    if (open) lenis?.stop(); else lenis?.start();
  };
  toggle.addEventListener('click', () => setOpen(header.dataset.open !== 'true'));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
</script>

<style>
  .site-header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: var(--z-header);
    background: transparent;
    transition: transform var(--dur-base) var(--ease-out), background-color var(--dur-base) var(--ease-out);
  }
  /* over the hero: a soft navy fade keeps the nav readable on bright sky */
  .site-header::before {
    content: ''; position: absolute; inset: 0 0 -40px 0; z-index: -1; pointer-events: none;
    background: linear-gradient(to bottom, color-mix(in srgb, var(--color-bg) 60%, transparent), transparent);
    transition: opacity var(--dur-base) var(--ease-out);
  }
  .site-header:global(.is-solid)::before, .site-header:global(.is-hidden)::before,
  .site-header.site-header--solid::before { opacity: 0; }
  .site-header:global(.is-solid) {
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(12px);
  }
  .site-header.site-header--solid { background: var(--color-bg); }
  /* without JS nothing can turn the overlay header solid: let it scroll away with the hero instead */
  :global(html:not(.js)) .site-header:not(.site-header--solid) { position: absolute; }
  .site-header:global(.is-hidden) { transform: translateY(-100%); }

  .site-header__inner {
    display: flex; align-items: center; gap: var(--space-5);
    min-height: 76px;
  }
  .brand { display: inline-flex; align-items: center; gap: var(--space-3); text-decoration: none; }
  .brand :global(.brand__mark) { width: 46px; }
  .brand__word { font-family: var(--font-display); font-weight: var(--weight-bold); font-size: var(--text-lg); }

  .site-nav { margin-inline-start: auto; }
  .site-nav ul { display: flex; gap: var(--space-5); }
  .site-nav a { text-decoration: none; font-size: var(--text-sm); color: var(--color-ink-muted); }
  .site-nav a:hover, .site-nav a[aria-current='page'] { color: var(--color-ink); }
  .site-header:not(.site-header--solid):not(:global(.is-solid)) .site-nav > ul > li > a { color: var(--color-ink); }

  /* «خدماتنا» submenu: opens on hover and on keyboard focus */
  .has-sub { position: relative; }
  .sub { display: grid; gap: var(--space-1); }
  @media (min-width: 1024px) {
    .site-nav .sub {
      position: absolute; inset-inline-start: calc(-1 * var(--space-4)); top: 100%;
      min-width: 16rem; padding: var(--space-3);
      margin-block-start: var(--space-3);
      background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: var(--radius-md);
      box-shadow: var(--shadow-lg);
      opacity: 0; visibility: hidden; translate: 0 -6px;
      transition: opacity var(--dur-fast) var(--ease-out), translate var(--dur-fast) var(--ease-out), visibility var(--dur-fast);
    }
    .site-nav .sub::before { content: ''; position: absolute; inset: calc(-1 * var(--space-3)) 0 100% 0; }  /* hover bridge */
    .has-sub:hover .sub, .has-sub:focus-within .sub { opacity: 1; visibility: visible; translate: 0 0; }
    .site-nav .sub a { display: block; padding: var(--space-2) var(--space-3); border-radius: var(--radius-sm); }
    .site-nav .sub a:hover { background: var(--color-surface); }
  }

  .site-header__actions { display: flex; align-items: center; gap: var(--space-4); }
  .lang { font-size: var(--text-sm); text-decoration: none; }

  .menu-toggle { display: none; width: 44px; height: 44px; place-items: center; }
  .menu-toggle__bars, .menu-toggle__bars::before, .menu-toggle__bars::after {
    display: block; width: 22px; height: 2px; background: currentColor; border-radius: 2px;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .menu-toggle__bars { position: relative; }
  .menu-toggle__bars::before, .menu-toggle__bars::after { content: ''; position: absolute; inset-inline-start: 0; }
  .menu-toggle__bars::before { top: -7px; }
  .menu-toggle__bars::after { top: 7px; }

  @media (max-width: 1023px) {
    .menu-toggle { display: grid; }
    .cta { display: none; }
    .site-nav {
      position: fixed; inset: 76px 0 0 0;
      background: var(--color-bg);
      padding: var(--space-7) var(--space-6);
      opacity: 0; visibility: hidden;
      transition: opacity var(--dur-base) var(--ease-out), visibility var(--dur-base);
    }
    .site-nav ul { flex-direction: column; gap: var(--space-5); }
    .site-nav a { font-size: var(--text-xl); color: var(--color-ink); }
    .site-nav .sub { margin-block-start: var(--space-3); padding-inline-start: var(--space-4); border-inline-start: 1px solid var(--color-border); }
    .site-nav .sub a { font-size: var(--text-base); color: var(--color-ink-muted); }
    .site-nav { overflow-y: auto; }
    .site-header[data-open='true'] .site-nav { opacity: 1; visibility: visible; }
    .site-header[data-open='true'] { background: var(--color-bg); }
    .site-header[data-open='true'] .menu-toggle__bars { background: transparent; }
    .site-header[data-open='true'] .menu-toggle__bars::before { transform: translateY(7px) rotate(45deg); }
    .site-header[data-open='true'] .menu-toggle__bars::after { transform: translateY(-7px) rotate(-45deg); }
  }
</style>
