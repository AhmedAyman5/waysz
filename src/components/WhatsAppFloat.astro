---
/** Floating WhatsApp button on every page (brief §5.6). Renders only when site.whatsapp is set. */
import { site, waHref } from '../lib/site';
import { useTranslations, type Lang } from '../i18n';

interface Props { lang: Lang }
const t = useTranslations(Astro.props.lang);
---
{site.whatsapp && (
  <a class="wa-float" href={waHref(site.whatsapp, t.whatsapp.message)} target="_blank" rel="noopener"
     aria-label={t.whatsapp.tooltip} title={t.whatsapp.tooltip}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.4-.7-2.8-1.1-4.6-4-4.8-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.6-.1l.9-1c.2-.3.4-.2.6-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3Z"/></svg>
  </a>
)}

<style>
  .wa-float {
    position: fixed;
    inset-block-end: 20px;
    inset-inline-start: 20px;
    z-index: var(--z-sticky);
    display: grid; place-items: center;
    width: 56px; height: 56px;
    border-radius: 50%;
    background: #25D366;            /* WhatsApp brand color — the one allowed raw color */
    color: #fff;
    box-shadow: var(--shadow-md);
  }
  .wa-float svg { width: 30px; height: 30px; fill: currentColor; }
</style>
